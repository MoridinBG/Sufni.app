    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sufni.Telemetry\Sufni.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Sufni.App.Tests/Fixtures/Codec/live-capture-v1.json" Link="Fixtures/Codec/live-capture-v1.json" CopyToOutputDirectory="PreserveNewest" />
