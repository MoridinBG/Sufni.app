<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 wants every CancellationToken-accepting call to pass TestContext.Current.CancellationToken.
         These unit tests already bound async waits with explicit timeouts, so the token would add boilerplate
         without practical benefit; suppress the rule for this test project. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sufni.App\Sufni.App\Sufni.App.csproj" />
    <ProjectReference Include="..\Sufni.App\Sufni.App.Desktop\Sufni.App.Desktop.csproj" />
    <ProjectReference Include="..\Sufni.App.ExtensionHost.TestSupport\Sufni.App.ExtensionHost.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sufni.App.Tests.ExtensionHost" />
    <Using Include="Sufni.App.ExtensionHost.TestSupport.Async" />
    <Using Include="Sufni.App.ExtensionHost.TestSupport.Doubles" />
    <Using Include="Sufni.App.ExtensionHost.TestSupport.Fixtures" />
    <Using Include="Sufni.App.ExtensionHost.TestSupport.Harness" />
    <Using Include="Sufni.App.ExtensionHost.TestSupport.Io" />
  </ItemGroup>

</Project>
