<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SufniEnableProfilingDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);SUFNI_PROFILING_DIAGNOSTICS</DefineConstants>
    <SufniProfilingProject Condition="'$(SufniProfilingProject)' == ''">$(MSBuildThisFileDirectory)../profiling/Sufni.Profiling/Sufni.Profiling.csproj</SufniProfilingProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(SufniEnableProfilingDiagnostics)' == 'true' and
                        ('$(MSBuildProjectName)' == 'Sufni.App' or
                         '$(MSBuildProjectName)' == 'Sufni.App.macOS')">
    <ProjectReference Include="$(SufniProfilingProject)" />
  </ItemGroup>
</Project>
