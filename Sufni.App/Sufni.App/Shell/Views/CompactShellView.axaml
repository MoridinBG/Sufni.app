<UserControl
Name="Root"
x:Class="Sufni.App.Shell.Views.CompactShellView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:converters="using:Avalonia.Data.Converters"
xmlns:itemlists="clr-namespace:Sufni.App.LiveDaq.ViewModels.ItemLists"
xmlns:itemlists2="clr-namespace:Sufni.App.Setups.ViewModels.ItemLists"
xmlns:itemlists3="clr-namespace:Sufni.App.Bikes.ViewModels.ItemLists"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:overlays="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:syncvm="clr-namespace:Sufni.App.SyncAndPairing.ViewModels"
xmlns:viewconverters="clr-namespace:Sufni.App.Shared.Views.Converters"
xmlns:vm="clr-namespace:Sufni.App.Shell.ViewModels"
xmlns:vml="clr-namespace:Sufni.App.Sessions.Lists.ViewModels.ItemLists"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:ShellRootViewModel"
Background="{DynamicResource SufniRegion}"
MainPages="{Binding Pages}"
mc:Ignorable="d">
    <UserControl.Resources>
        <viewconverters:ProgressToArcConverter x:Key="ProgressToArcConverter" />
    </UserControl.Resources>

    <Panel>
    <DrawerPage
    Name="MainDrawerPage"
    DrawerLength="160"
    IsOpen="{Binding Pages.IsDrawerOpen, Mode=TwoWay}">
        <DrawerPage.Resources>
            <!--  The Labs DrawerPage header band (PART_TopBar) defaults to 48px and
                  has 5px padding, leaving ~38px which clips the 39px search field.
                  Give the band enough height to show the field with breathing room.  -->
            <x:Double x:Key="NavigationControlNavBarHeight">56</x:Double>
        </DrawerPage.Resources>
        <DrawerPage.Header>
            <ContentControl Content="{Binding Pages.SelectedPrimaryPageContent}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vml:SessionListViewModel">
                        <controls:SearchBar Margin="0,0,20,0" ShowDrawerButton="False" />
                    </DataTemplate>
                    <DataTemplate DataType="itemlists2:SetupListViewModel">
                        <controls:SearchBar Margin="0,0,20,0" ShowDrawerButton="False" />
                    </DataTemplate>
                    <DataTemplate DataType="itemlists3:BikeListViewModel">
                        <controls:SearchBar Margin="0,0,20,0" ShowDrawerButton="False" />
                    </DataTemplate>
                    <DataTemplate DataType="itemlists:LiveDaqListViewModel">
                        <controls:SearchBar Margin="0,0,20,0" ShowDrawerButton="False" />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </DrawerPage.Header>
        <DrawerPage.Drawer>
            <controls:SidePanel
            Name="MenuPanel"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            DataContext="{Binding #Root.((vm:ShellRootViewModel)DataContext).Pages}" />
        </DrawerPage.Drawer>
        <DrawerPage.Content>
            <TabbedPage
            Name="PagesTabbedPage"
            Background="{DynamicResource SufniBackgroundDisabled}"
            TabPlacement="Bottom">
                <TabbedPage.Pages>
                    <ContentPage
                    Header="Sessions"
                    Content="{Binding #Root.((vm:ShellRootViewModel)DataContext).Pages.SessionsPage}"
                    AutomaticallyApplySafeAreaPadding="False">
                        <ContentPage.Icon>
                            <Image Width="18" Source="{SvgImage /Assets/fa-chart-line.svg}" />
                        </ContentPage.Icon>
                    </ContentPage>
                    <ContentPage
                    Header="Setups"
                    Content="{Binding #Root.((vm:ShellRootViewModel)DataContext).Pages.SetupsPage}"
                    AutomaticallyApplySafeAreaPadding="False">
                        <ContentPage.Icon>
                            <Image Width="18" Source="{SvgImage /Assets/cog.svg}" />
                        </ContentPage.Icon>
                    </ContentPage>
                    <ContentPage
                    Header="Bikes"
                    Content="{Binding #Root.((vm:ShellRootViewModel)DataContext).Pages.BikesPage}"
                    AutomaticallyApplySafeAreaPadding="False">
                        <ContentPage.Icon>
                            <Image Width="18" Source="{SvgImage /Assets/fa-person-mountainbiking.svg}" />
                        </ContentPage.Icon>
                    </ContentPage>
                    <ContentPage
                    Header="Live"
                    Content="{Binding #Root.((vm:ShellRootViewModel)DataContext).Pages.LiveDaqsPage}"
                    AutomaticallyApplySafeAreaPadding="False">
                        <ContentPage.Icon>
                            <Image Width="18" Source="{SvgImage /Assets/fa-link.svg}" />
                        </ContentPage.Icon>
                    </ContentPage>
                </TabbedPage.Pages>
            </TabbedPage>
        </DrawerPage.Content>
    </DrawerPage>

        <Grid
        Name="CompactPairedDevicesPanel"
        Height="300"
        Margin="12,0,12,84"
        VerticalAlignment="Bottom"
        DataContext="{Binding Pages}"
        Opacity="0.9">
            <Grid.IsVisible>
                <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                    <Binding Path="CanHostSyncServer" />
                    <Binding Path="IsPairedDevicesListOpen" />
                </MultiBinding>
            </Grid.IsVisible>
            <ContentControl Content="{Binding PairedDevicesPage}" />
            <overlays:BusyOverlay
            Name="CompactSyncBusyOverlay"
            BusyMessageFontWeight="Bold"
            ConsumesInput="False"
            IndicatorForeground="{DynamicResource SufniAccentColor}"
            IsActive="{Binding SyncInProgress}"
            IsProgressIndeterminate="{Binding SyncProgressIsIndeterminate}"
            IsVisible="{Binding SyncInProgress}"
            Message="{Binding SyncProgressText}"
            MessageForeground="{DynamicResource SufniAccentColor}"
            ProgressValue="{Binding SyncProgressValue}"
            ShowProgress="{Binding SyncInProgress}"
            ShowTint="True"
            TintBackground="{DynamicResource SufniSelectionSurfaceSubtle}"
            TintOpacity="0.85"
            UseStackLayout="True" />
        </Grid>

        <ContentControl
        Name="CompactPairingRequestPanel"
        Margin="12,0,12,84"
        VerticalAlignment="Bottom"
        Content="{Binding Pages.PairingServerViewModel}"
        IsVisible="{Binding Pages.IsPairingRequestVisible}"
        Opacity="0.9">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="syncvm:PairingServerViewModel" x:DataType="syncvm:PairingServerViewModel">
                    <Grid
                    Background="{DynamicResource SufniSelectionSurfaceSubtle}"
                    ColumnDefinitions="* 35"
                    RowDefinitions="auto 24">

                        <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="10,10,10,10"
                        FontSize="{StaticResource SufniFontSizeHeading}">
                            <Run Text="Pairing request from " />
                            <LineBreak />
                            <Run FontWeight="Bold" Text="{Binding RequestingName}" />
                        </TextBlock>

                        <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10,0,10,10"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        LetterSpacing="10"
                        Text="{Binding PairingPin}" />

                        <Path
                        Grid.Row="1"
                        Grid.Column="1"
                        Data="{Binding Remaining, Converter={StaticResource ProgressToArcConverter}}"
                        Fill="{DynamicResource SufniAccentSpinner}"
                        Stroke="{DynamicResource SufniAccentSpinner}"
                        StrokeLineCap="Round" />
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <Border
        Name="CompactWorkspaceDetailHost"
        Background="{DynamicResource SufniRegion}"
        IsVisible="{Binding Workspace.CurrentTab, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
        ZIndex="10">
            <ContentControl Content="{Binding Workspace.CurrentTab}" />
        </Border>
    </Panel>
</UserControl>
