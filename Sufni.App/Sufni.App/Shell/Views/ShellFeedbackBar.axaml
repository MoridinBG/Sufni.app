<UserControl
    x:Class="Sufni.App.Shell.Views.ShellFeedbackBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Controls"
    xmlns:vm="clr-namespace:Sufni.App.Shell.ViewModels"
    x:DataType="vm:ShellFeedbackViewModel">
    <StackPanel Spacing="4">
        <controls:NotificationsBar Name="Notifications" />
        <controls:ErrorMessagesBar Name="Errors" />
    </StackPanel>
</UserControl>
