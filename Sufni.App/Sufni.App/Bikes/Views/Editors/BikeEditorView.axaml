<UserControl
x:Class="Sufni.App.Bikes.Views.Editors.BikeEditorView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:c="using:Sufni.App.Shared.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:editorViews="using:Sufni.App.Bikes.Views.Editors"
xmlns:plots="clr-namespace:Sufni.App.Bikes.Views.Plots"
xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
xmlns:shared="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:vm="using:Sufni.App.Bikes.ViewModels.Editors"
xmlns:zoom="clr-namespace:Sufni.App.Shared.Views.Plots"
xmlns:lifecycle="clr-namespace:Sufni.App.Shared.Views"
d:DesignHeight="450"
d:DesignWidth="800"
x:DataType="vm:BikeEditorViewModel"
lifecycle:ViewLifecycle.LoadedCommand="{Binding LoadedCommand}"
lifecycle:ViewLifecycle.UnloadedCommand="{Binding UnloadedCommand}"
mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid
    Margin="20,10,20,10"
    ColumnDefinitions="* 2* 2* *"
    RowDefinitions="auto auto auto auto auto auto auto auto auto * auto auto">

        <!--  Name  -->
        <c:EditableTitle
        Grid.Row="0"
        Grid.ColumnSpan="4"
        Margin="0,0,0,10"
        HorizontalAlignment="Stretch" />

        <!--  Bike image  -->
        <Image
        Name="BikeImage"
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="4"
        Margin="0,0,0,10"
        Source="{Binding Linkage.Canvas.RotatedImage}" />

        <!--  Head angle  -->
        <editorViews:BikeFrameSummaryView Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" Grid.ColumnSpan="2" DataContext="{Binding Frame}" />

        <!--  Chainstay  -->
        <TextBlock
        Grid.Row="5"
        Grid.Column="1"
        Margin="0,0,0,5"
        Text="Chainstay (mm)" />
        <TextBlock
        Grid.Row="5"
        Grid.Column="2"
        Margin="0,0,0,5"
        Text="{Binding Linkage.Chainstay, StringFormat={}{0:0.##}}"
        TextAlignment="Right" />

        <!--  Front wheel (only if configured)  -->
        <TextBlock
        Grid.Row="6"
        Grid.Column="1"
        Margin="0,0,0,5"
        Text="Front wheel">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="RearSuspension.IsLinkageMode" />
                    <Binding Path="Wheels.HasWheels" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock
        Grid.Row="6"
        Grid.Column="2"
        Margin="0,0,0,5"
        Text="{Binding Wheels.FrontWheelDisplayText}"
        TextAlignment="Right">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="RearSuspension.IsLinkageMode" />
                    <Binding Path="Wheels.HasWheels" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <!--  Rear wheel (only if configured)  -->
        <TextBlock
        Grid.Row="7"
        Grid.Column="1"
        Margin="0,0,0,5"
        Text="Rear wheel">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="RearSuspension.IsLinkageMode" />
                    <Binding Path="Wheels.HasWheels" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock
        Grid.Row="7"
        Grid.Column="2"
        Margin="0,0,0,5"
        Text="{Binding Wheels.RearWheelDisplayText}"
        TextAlignment="Right">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="RearSuspension.IsLinkageMode" />
                    <Binding Path="Wheels.HasWheels" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>

        <StackPanel
        Grid.Row="8"
        Grid.Column="0"
        Grid.ColumnSpan="4"
        Margin="0,5,0,0"
        Spacing="6">
            <Grid ColumnDefinitions="* auto">
                <TextBlock Text="Rear suspension" />
                <TextBlock Grid.Column="1" Text="{Binding RearSuspension.RearSuspensionModeDisplayName}" TextAlignment="Right" />
            </Grid>

            <Border IsVisible="{Binding RearSuspension.IsLeverageRatioMode}">
                <editorViews:LeverageRatioEditorView DataContext="{Binding LeverageRatioEditor}" />
            </Border>
        </StackPanel>

        <!--  Leverage ratio plot  -->
        <editorViews:BikeAnalysisPlotView Name="AnalysisPlot" Grid.Row="9" Grid.ColumnSpan="4" Margin="0,10" DataContext="{Binding Analysis}" />

        <!--  Error messages for Bike instance  -->
        <c:ErrorMessagesBar
        Grid.Row="10"
        Grid.Column="0"
        Grid.ColumnSpan="4"
        Margin="0,5,0,0" />

        <!--  Back, Save, Reset and Delete buttons  -->
        <c:CommonButtonLine
        Grid.Row="11"
        Grid.Column="0"
        Grid.ColumnSpan="4" />

        <shared:EditorBusyOverlay
        Grid.Row="0"
        Grid.RowSpan="12"
        Grid.Column="0"
        Grid.ColumnSpan="4">
            <shared:EditorBusyOverlay.IsActive>
                <Binding Path="IsBusy" />
            </shared:EditorBusyOverlay.IsActive>
        </shared:EditorBusyOverlay>

    </Grid>

</UserControl>
