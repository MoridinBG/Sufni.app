<UserControl
    x:Class="Sufni.App.Bikes.DesktopViews.Editors.LinkageControlsDesktopView"
    xmlns="https://github.com/avaloniaui"
    xmlns:editors="using:Sufni.App.Bikes.Views.Editors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sufni.App.Bikes.ViewModels.Editors"
    xmlns:vml="using:Sufni.App.Bikes.ViewModels.LinkageEditing"
    xmlns:shortcuts="using:Sufni.App.Shell.KeyboardShortcuts"
    x:DataType="vm:LinkageWorkspaceViewModel"
    IsVisible="{Binding IsLinkageMode}">
    <Grid RowDefinitions="auto auto auto auto auto auto auto" ColumnDefinitions="auto *">
        <TextBlock Grid.Column="0" Grid.Row="0"
        Margin="0,0,0,5"
        Text="Chainstay (mm)" />
        <NumericUpDown Grid.Column="1" Grid.Row="0"
        Margin="0,0,0,5"
        Maximum="1000"
        Minimum="0"
        FormatString="0.##"
        Value="{Binding Chainstay}" />
        <Grid Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1"
        Margin="0,0,0,15"
        ColumnDefinitions="* auto">

            <Button
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,5,0"
            HorizontalAlignment="Stretch"
            Command="{Binding OpenImageCommand}"
            Content="Open image ..." />

            <CheckBox
            Grid.Row="0"
            Grid.Column="1"
            Content="Draw overlay"
            IsChecked="{Binding OverlayVisible}" />
        </Grid>
        <TextBlock Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="2"
        Margin="0,0,0,5"
        Text="Points">
        </TextBlock>
        <ScrollViewer Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="3"
        Margin="2,0,2,6">

            <DataGrid Name="JointGrid"
            BeginningEdit="DataGrid_OnBeginningEdit"
            BorderBrush="Gray"
            BorderThickness="1"

            GridLinesVisibility="All"
            ItemsSource="{Binding JointViewModels}"
            SelectedItem="{Binding SelectedPoint}">

                <DataGrid.KeyBindings>
                    <KeyBinding Command="{Binding DeleteSelectedItemCommand}" Gesture="{shortcuts:ShortcutGesture Source=DesktopViews.Editors.LinkageControlsDesktopView, Id=delete-selection}" />
                </DataGrid.KeyBindings>

                <DataGrid.Columns>

                    <DataGridTextColumn
                    Width="1.5*"
                    Binding="{Binding Name}"
                    Header="Name"
                    IsReadOnly="False" />

                    <DataGridTemplateColumn
                    Width="1.5*"
                    Header="Type"
                    IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vml:JointRowViewModel">
                                <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding Type}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate DataType="vml:JointRowViewModel">
                                <editors:JointTypePicker
                                HorizontalAlignment="Stretch"
                                IsDropDownOpen="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                    Width="*"
                    Binding="{Binding X, StringFormat={}{0:0.00}}"
                    Header="X (px)"
                    IsReadOnly="True" />

                    <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Y, StringFormat={}{0:0.00}}"
                    Header="Y (px)"
                    IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
        <TextBlock Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="4"
        Margin="0,0,0,5"
        Text="Links">
        </TextBlock>
        <ScrollViewer Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="5"
        Margin="2,0,2,5">

            <DataGrid Name="LinkGrid"
            BeginningEdit="DataGrid_OnBeginningEdit"
            BorderBrush="Gray"
            BorderThickness="1"

            GridLinesVisibility="All"
            ItemsSource="{Binding LinkViewModels}"
            SelectedItem="{Binding SelectedLink}">

                <DataGrid.KeyBindings>
                    <KeyBinding Command="{Binding DeleteSelectedItemCommand}" Gesture="{shortcuts:ShortcutGesture Source=DesktopViews.Editors.LinkageControlsDesktopView, Id=delete-selection}" />
                </DataGrid.KeyBindings>

                <DataGrid.Columns>

                    <DataGridTemplateColumn
                    Width="*"
                    Header="Point A"
                    IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vml:LinkRowViewModel">
                                <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding A.Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate DataType="vml:LinkRowViewModel">
                                <ComboBox
                                HorizontalAlignment="Stretch"
                                IsDropDownOpen="True"
                                ItemsSource="{Binding JointOptions}"
                                SelectedItem="{Binding A}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                    Width="*"
                    Header="Point B"
                    IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vml:LinkRowViewModel">
                                <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding B.Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate DataType="vml:LinkRowViewModel">
                                <ComboBox
                                HorizontalAlignment="Stretch"
                                IsDropDownOpen="True"
                                ItemsSource="{Binding JointOptions}"
                                SelectedItem="{Binding B}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Length, StringFormat={}{0:0.00}}"
                    Header="L (mm)"
                    IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
        <Button Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="6"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        Command="{Binding CreateLinkCommand}"
        Content="Add new link">
        </Button>
    </Grid>
</UserControl>
