<UserControl
    x:Class="Sufni.App.Bikes.DesktopViews.Editors.BikeEditorControlsDesktopView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sufni.App.Bikes.ViewModels.Editors"
    xmlns:controls="using:Sufni.App.Shared.Views.Controls"
    xmlns:editorViews="using:Sufni.App.Bikes.Views.Editors"
    xmlns:sections="using:Sufni.App.Bikes.DesktopViews.Editors"
    x:DataType="vm:BikeEditorViewModel"
    Background="{DynamicResource SufniSurfacePage}">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <Grid RowDefinitions="auto" ColumnDefinitions="auto *">
                <TextBlock Grid.Column="0" Grid.Row="0"
                Margin="0,0,10,5"
                Text="Name" />
                <TextBox Grid.Column="1" Grid.Row="0"
                Margin="0,0,0,5"
                Text="{Binding Name}" />
            </Grid>
            <sections:RearSuspensionModeSelectorDesktopView DataContext="{Binding RearSuspension}" />
            <sections:BikeFrameFieldsDesktopView DataContext="{Binding Frame}" />
            <sections:BikeWheelsEditorDesktopView DataContext="{Binding Wheels}" />
            <sections:LinkageControlsDesktopView DataContext="{Binding Linkage}" />
            <Border IsVisible="{Binding RearSuspension.IsLeverageRatioMode}">
                <editorViews:LeverageRatioEditorView DataContext="{Binding LeverageRatioEditor}" />
            </Border>
            <editorViews:BikeAnalysisPlotView Height="250" DataContext="{Binding Analysis}" />
            <controls:ErrorMessagesBar />
            <Button
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding ExportCommand}"
            Content="Export as JSON" />
            <Button
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding SaveCommand}"
            Content="Save" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
