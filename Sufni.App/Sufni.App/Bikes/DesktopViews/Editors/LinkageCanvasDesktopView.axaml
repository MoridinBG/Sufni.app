<UserControl
x:Class="Sufni.App.Bikes.DesktopViews.Editors.LinkageCanvasDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:paz="using:Avalonia.Controls.PanAndZoom"
xmlns:shortcuts="using:Sufni.App.Shell.KeyboardShortcuts"
xmlns:v="using:Sufni.App.Bikes.Views.Items"
xmlns:vl="using:Sufni.App.Bikes.Views.Editors"
xmlns:vm="using:Sufni.App.Bikes.ViewModels.Editors"
xmlns:vml="using:Sufni.App.Bikes.ViewModels.LinkageEditing"
d:DesignHeight="450"
d:DesignWidth="800"
x:DataType="vm:LinkageWorkspaceViewModel"
mc:Ignorable="d">

    <UserControl.Styles>
        <StyleInclude Source="avares://Xaml.Behaviors.Interactions.Draggable/Styles.axaml" />
        <Style Selector="SelectingItemsControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border>
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <paz:ZoomBorder
    Name="ZoomBorder"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Focusable="True"
    Stretch="None"
    ZoomSpeed="1.2"
    DoubleTapped="Canvas_DoubleTapped"
    Tapped="Canvas_Tapped">


        <paz:ZoomBorder.KeyBindings>
            <KeyBinding Command="{Binding DeleteSelectedItemCommand}" Gesture="{shortcuts:ShortcutGesture Source=DesktopViews.Editors.LinkageCanvasDesktopView, Id=delete-selection}" />
        </paz:ZoomBorder.KeyBindings>

        <Viewbox>
            <Canvas
            Width="{Binding CanvasWidth}"
            Height="{Binding CanvasHeight}"
            Background="Transparent">
                <Panel Canvas.Left="{Binding ContentOffsetX}" Canvas.Top="{Binding ContentOffsetY}">
                    <Canvas>
                        <Image
                        Name="BikeImage"
                        Canvas.Left="{Binding RotatedImageLeft}"
                        Canvas.Top="{Binding RotatedImageTop}"
                        Source="{Binding Canvas.RotatedImage}" />
                    </Canvas>

                    <!--  Semi-opaque overlay to improve point visibility  -->
                    <Canvas IsVisible="{Binding OverlayVisible}">
                        <Border
                        Width="{Binding Canvas.Image.PixelSize.Width}"
                        Height="{Binding Canvas.Image.PixelSize.Height}"
                        Background="White"
                        Opacity="0.7"
                        RenderTransformOrigin="0,0">
                            <Border.RenderTransform>
                                <RotateTransform Angle="{Binding ImageRotationDegrees}" />
                            </Border.RenderTransform>
                        </Border>
                    </Canvas>

                    <Canvas Name="WheelOverlayCanvas">
                        <Canvas.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsLinkageMode" />
                                <Binding Path="Wheels.HasWheels" />
                            </MultiBinding>
                        </Canvas.IsVisible>
                        <Grid
                        Canvas.Left="{Binding Wheels.FrontWheelCircleLeft}"
                        Canvas.Top="{Binding Wheels.FrontWheelCircleTop}"
                        Width="{Binding Wheels.FrontWheelCircleDiameter}"
                        Height="{Binding Wheels.FrontWheelCircleDiameter}">
                            <Ellipse Stroke="#90404040" StrokeThickness="{Binding Wheels.FrontTireThickness}" Fill="Transparent" />
                            <Ellipse
                            Width="{Binding Wheels.FrontRimCircleDiameter}"
                            Height="{Binding Wheels.FrontRimCircleDiameter}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="#D0C0C0C0"
                            StrokeThickness="15"
                            Fill="Transparent" />
                            <Ellipse
                            Width="{Binding Wheels.FrontHubDiameter}"
                            Height="{Binding Wheels.FrontHubDiameter}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#90505050" />
                        </Grid>
                        <Grid
                        Canvas.Left="{Binding Wheels.RearWheelCircleLeft}"
                        Canvas.Top="{Binding Wheels.RearWheelCircleTop}"
                        Width="{Binding Wheels.RearWheelCircleDiameter}"
                        Height="{Binding Wheels.RearWheelCircleDiameter}">
                            <Ellipse Stroke="#90404040" StrokeThickness="{Binding Wheels.RearTireThickness}" Fill="Transparent" />
                            <Ellipse
                            Width="{Binding Wheels.RearRimCircleDiameter}"
                            Height="{Binding Wheels.RearRimCircleDiameter}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="#D0C0C0C0"
                            StrokeThickness="15"
                            Fill="Transparent" />
                            <Ellipse
                            Width="{Binding Wheels.RearHubDiameter}"
                            Height="{Binding Wheels.RearHubDiameter}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#90505050" />
                        </Grid>
                    </Canvas>

                    <Polyline
                    Points="{Binding RearAxlePath}"
                    Stroke="Cyan"
                    StrokeThickness="10"
                    IsVisible="{Binding !!RearAxlePath.Count}" />

                    <SelectingItemsControl
                    Background="Transparent"
                    ClipToBounds="False"
                    IsVisible="{Binding Canvas.Image, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ItemsSource="{Binding LinkViewModels}"
                    SelectedItem="{Binding SelectedLink}">
                        <SelectingItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </SelectingItemsControl.ItemsPanel>
                        <SelectingItemsControl.ItemTemplate>
                            <DataTemplate DataType="vml:LinkRowViewModel">
                                <Line
                                Opacity="0.6"
                                Stroke="{Binding Brush}"
                                StrokeThickness="{Binding Workspace.LinkStrokeThickness}"
                                StartPoint="{Binding StartPoint}"
                                EndPoint="{Binding EndPoint}"
                                Tapped="Link_Tapped">

                                </Line>
                            </DataTemplate>
                        </SelectingItemsControl.ItemTemplate>
                    </SelectingItemsControl>

                    <SelectingItemsControl
                    Background="Transparent"
                    Classes="draggable"
                    ClipToBounds="False"
                    IsVisible="{Binding Canvas.Image, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ItemsSource="{Binding JointViewModels}"
                    SelectedItem="{Binding SelectedPoint}">
                        <SelectingItemsControl.Styles>
                            <Style x:DataType="vml:JointRowViewModel" Selector="SelectingItemsControl &gt; ContentPresenter">
                                <Setter Property="(Canvas.Left)" Value="{Binding X, Mode=TwoWay}" />
                                <Setter Property="(Canvas.Top)" Value="{Binding Y, Mode=TwoWay}" />
                            </Style>
                            <Style Selector="SelectingItemsControl &gt; ContentPresenter:dragging">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="ZIndex" Value="1" />
                            </Style>
                        </SelectingItemsControl.Styles>
                        <SelectingItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </SelectingItemsControl.ItemsPanel>
                        <SelectingItemsControl.ItemTemplate>
                            <DataTemplate>
                                <vl:JointView Tapped="Point_Tapped">

                                </vl:JointView>
                            </DataTemplate>
                        </SelectingItemsControl.ItemTemplate>
                    </SelectingItemsControl>
                </Panel>
            </Canvas>
        </Viewbox>
    </paz:ZoomBorder>
</UserControl>
