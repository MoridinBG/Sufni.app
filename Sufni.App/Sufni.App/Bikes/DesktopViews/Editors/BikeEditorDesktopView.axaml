<UserControl
x:Class="Sufni.App.Bikes.DesktopViews.Editors.BikeEditorDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:shared="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:v="using:Sufni.App.Bikes.DesktopViews.Items"
xmlns:vm="using:Sufni.App.Bikes.ViewModels.Editors"
xmlns:lifecycle="clr-namespace:Sufni.App.Shared.Views"
d:DesignHeight="450"
d:DesignWidth="800"
x:DataType="vm:BikeEditorViewModel"
lifecycle:ViewLifecycle.LoadedCommand="{Binding LoadedCommand}"
lifecycle:ViewLifecycle.UnloadedCommand="{Binding UnloadedCommand}"
mc:Ignorable="d">

    <Grid>

        <SplitView
        DisplayMode="Inline"
        IsPaneOpen="True"
        OpenPaneLength="400"
        PanePlacement="Right">

            <SplitView.Pane>
                <v:BikeImageControlsDesktopView />
            </SplitView.Pane>

            <!--  Bike image / linkage  -->
            <v:BikeImageDesktopView />

        </SplitView>

        <shared:EditorBusyOverlay>
            <shared:EditorBusyOverlay.IsActive>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="LoadedCommand.IsRunning" />
                    <Binding Path="OpenImageCommand.IsRunning" />
                    <Binding Path="SaveCommand.IsRunning" />
                </MultiBinding>
            </shared:EditorBusyOverlay.IsActive>
        </shared:EditorBusyOverlay>

    </Grid>

</UserControl>
