<UserControl
x:Class="Sufni.App.Bikes.DesktopViews.Items.BikeImageControlsDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:controls="using:Sufni.App.Shared.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:editorViews="using:Sufni.App.Bikes.Views.Editors"
xmlns:bikeVm="using:Sufni.App.Bikes.ViewModels.Editors"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:models="using:Sufni.App.Bikes.Models"
xmlns:plots="clr-namespace:Sufni.App.Bikes.Views.Plots"
xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
xmlns:shortcuts="using:Sufni.App.Shell.KeyboardShortcuts"
xmlns:v="using:Sufni.App.Bikes.DesktopViews.Items"
xmlns:vm="using:Sufni.App.Bikes.ViewModels.Editors"
xmlns:vmle="using:Sufni.App.Bikes.ViewModels.LinkageEditing"
xmlns:vml="using:Sufni.App.Bikes.ViewModels.LinkageEditing"
xmlns:zoom="clr-namespace:Sufni.App.Shared.Views.Plots"
d:DesignHeight="600"
d:DesignWidth="400"
x:DataType="vm:BikeEditorViewModel"
Background="{DynamicResource SufniSurfacePage}"
mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">

        <Grid
        Margin="10"
        ColumnDefinitions="auto *"
        RowDefinitions="auto auto auto auto auto auto auto auto auto auto auto auto auto auto auto auto auto auto auto auto">

            <!--  Name  -->
            <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,10,5"
            Text="Name" />
            <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,5"
            Text="{Binding Name}" />

            <Grid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            ColumnDefinitions="* * *">
                <ToggleButton
                Grid.Column="0"
                Margin="0,0,5,0"
                Command="{Binding RearSuspension.SetRearSuspensionModeCommand}"
                CommandParameter="{x:Static models:RearSuspensionKind.None}"
                IsChecked="{Binding RearSuspension.IsHardtailMode}"
                IsEnabled="{Binding RearSuspension.CanChangeRearSuspensionMode}"
                Content="Hardtail" />
                <ToggleButton
                Name="LinkageModeButton"
                Grid.Column="1"
                Margin="0,0,5,0"
                Command="{Binding RearSuspension.SetRearSuspensionModeCommand}"
                CommandParameter="{x:Static models:RearSuspensionKind.Linkage}"
                IsChecked="{Binding RearSuspension.IsLinkageMode}"
                IsEnabled="{Binding RearSuspension.CanChangeRearSuspensionMode}"
                Content="Linkage" />
                <ToggleButton
                Grid.Column="2"
                Command="{Binding RearSuspension.SetRearSuspensionModeCommand}"
                CommandParameter="{x:Static models:RearSuspensionKind.LeverageRatio}"
                IsChecked="{Binding RearSuspension.IsLeverageRatioMode}"
                IsEnabled="{Binding RearSuspension.CanChangeRearSuspensionMode}"
                Content="Leverage ratio" />
            </Grid>

            <!--  Head angle  -->
            <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,0,5"
            Text="Head angle (°)" />
            <NumericUpDown
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,0,5"
            Maximum="90"
            Minimum="0"
            IsReadOnly="{Binding Frame.IsHeadAngleDerived}"
            Value="{Binding Frame.HeadAngle}" />

            <!--  Fork stroke  -->
            <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,0,0,5"
            Text="Fork stroke (mm)" />
            <NumericUpDown
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,0,0,5"
            Maximum="300"
            Minimum="0"
            Value="{Binding Frame.ForksStroke}" />

            <!--  Shock stroke  -->
            <TextBlock
            Name="ShockStrokeLabel"
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,0,10,5"
            IsVisible="{Binding Frame.HasRearSuspension}"
            Text="Shock stroke (mm)" />
            <NumericUpDown
            Name="ShockStrokeNumericUpDown"
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,0,0,5"
            IsVisible="{Binding Frame.HasRearSuspension}"
            Maximum="1000"
            Minimum="0"
            Value="{Binding Frame.ShockStroke}" />

            <!--  Chainstay  -->
            <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Margin="0,0,0,5"
            IsVisible="{Binding RearSuspension.IsLinkageMode}"
            Text="Chainstay (mm)" />
            <NumericUpDown
            Grid.Row="5"
            Grid.Column="1"
            Margin="0,0,0,5"
            IsVisible="{Binding RearSuspension.IsLinkageMode}"
            Maximum="1000"
            Minimum="0"
            Value="{Binding Linkage.Chainstay}" />

            <!--  Front Wheel  -->
            <Grid
            Name="FrontWheelEditorHeaderGrid"
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,10,0,5"
            ColumnDefinitions="auto,*">
                <Grid.IsVisible>
                    <Binding Path="Wheels.IsWheelEditingAvailable" />
                </Grid.IsVisible>
                <Button
                Grid.Column="0"
                Width="28"
                Height="28"
                MinWidth="28"
                MinHeight="28"
                Margin="0,0,8,0"
                Padding="0"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding Wheels.RemoveFrontWheelCommand}"
                Content="X" />
                <TextBlock
                Grid.Column="1"
                FontWeight="SemiBold"
                Text="Front Wheel" />
            </Grid>
            <Grid
            Name="FrontWheelEditorInputsGrid"
            Grid.Row="7"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,5"
            ColumnDefinitions="* * *"
            x:DataType="vm:BikeWheelsWorkspaceViewModel"
            DataContext="{Binding Wheels}">
                <Grid.IsVisible>
                    <Binding Path="IsWheelEditingAvailable" />
                </Grid.IsVisible>
                <ComboBox
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Margin="0,0,5,0"
                ItemsSource="{Binding RimSizeOptions}"
                PlaceholderText="Rim"
                SelectedValue="{Binding FrontWheelRimSize}"
                SelectedValueBinding="{Binding Value, DataType=vm:RimSizeOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RimSizeOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <NumericUpDown
                Grid.Column="1"
                Margin="0,0,5,0"
                FormatString="0.00"
                Increment="0.05"
                Maximum="5"
                Minimum="1"
                Value="{Binding FrontWheelTireWidth}"
                PlaceholderText="Width" />
                <NumericUpDown
                Grid.Column="2"
                FormatString="0.0"
                Increment="1"
                Maximum="1000"
                Minimum="400"
                Value="{Binding FrontWheelDiameter}"
                PlaceholderText="Ø mm" />
            </Grid>

            <!--  Rear Wheel  -->
            <Grid
            Name="RearWheelEditorHeaderGrid"
            Grid.Row="8"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,10,0,5"
            ColumnDefinitions="auto,*">
                <Grid.IsVisible>
                    <Binding Path="Wheels.IsWheelEditingAvailable" />
                </Grid.IsVisible>
                <Button
                Grid.Column="0"
                Width="28"
                Height="28"
                MinWidth="28"
                MinHeight="28"
                Margin="0,0,8,0"
                Padding="0"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding Wheels.RemoveRearWheelCommand}"
                Content="X" />
                <TextBlock
                Grid.Column="1"
                FontWeight="SemiBold"
                Text="Rear Wheel" />
            </Grid>
            <Grid
            Name="RearWheelEditorInputsGrid"
            Grid.Row="9"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,5"
            ColumnDefinitions="* * *"
            x:DataType="vm:BikeWheelsWorkspaceViewModel"
            DataContext="{Binding Wheels}">
                <Grid.IsVisible>
                    <Binding Path="IsWheelEditingAvailable" />
                </Grid.IsVisible>
                <ComboBox
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Margin="0,0,5,0"
                ItemsSource="{Binding RimSizeOptions}"
                PlaceholderText="Rim"
                SelectedValue="{Binding RearWheelRimSize}"
                SelectedValueBinding="{Binding Value, DataType=vm:RimSizeOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RimSizeOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <NumericUpDown
                Grid.Column="1"
                Margin="0,0,5,0"
                FormatString="0.00"
                Increment="0.05"
                Maximum="5"
                Minimum="1"
                Value="{Binding RearWheelTireWidth}"
                PlaceholderText="Width" />
                <NumericUpDown
                Grid.Column="2"
                FormatString="0.0"
                Increment="1"
                Maximum="1000"
                Minimum="400"
                Value="{Binding RearWheelDiameter}"
                PlaceholderText="Ø mm" />
            </Grid>

            <Grid
            Grid.Row="10"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,15"
            ColumnDefinitions="* auto">
                <Grid.IsVisible>
                    <Binding Path="RearSuspension.IsLinkageMode" />
                </Grid.IsVisible>

                <!--  Open bike picture  -->
                <Button
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Stretch"
                Command="{Binding Linkage.OpenImageCommand}"
                Content="Open image ..." />

                <!--  Overlay  -->
                <CheckBox
                Grid.Row="0"
                Grid.Column="1"
                Content="Draw overlay"
                IsChecked="{Binding Linkage.OverlayVisible}" />
            </Grid>

            <!--  List of Points  -->
            <TextBlock
            Grid.Row="11"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,5"
            Text="Points">
                <TextBlock.IsVisible>
                    <Binding Path="RearSuspension.IsLinkageMode" />
                </TextBlock.IsVisible>
            </TextBlock>
            <ScrollViewer
            Grid.Row="12"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="2,0,2,6">

                <DataGrid
                x:DataType="vm:LinkageWorkspaceViewModel"
                BeginningEdit="DataGrid_OnBeginningEdit"
                BorderBrush="Gray"
                BorderThickness="1"
                DataContext="{Binding Linkage}"
                GridLinesVisibility="All"
                ItemsSource="{Binding JointViewModels}"
                SelectedItem="{Binding SelectedPoint}">

                    <DataGrid.IsVisible>
                        <Binding Path="IsLinkageMode" />
                    </DataGrid.IsVisible>

                    <DataGrid.KeyBindings>
                        <KeyBinding Command="{Binding DeleteSelectedItemCommand}" Gesture="{shortcuts:ShortcutGesture Source=DesktopViews.Items.BikeImageControlsDesktopView, Id=delete-selection}" />
                    </DataGrid.KeyBindings>

                    <DataGrid.Columns>

                        <!--  Name  -->
                        <DataGridTextColumn
                        Width="1.5*"
                        Binding="{Binding Name}"
                        Header="Name"
                        IsReadOnly="False" />

                        <!--  Type  -->
                        <DataGridTemplateColumn
                        Width="1.5*"
                        Header="Type"
                        IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vml:JointRowViewModel">
                                    <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Type}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="vml:JointRowViewModel">
                                    <ComboBox
                                    HorizontalAlignment="Stretch"
                                    IsDropDownOpen="True"
                                    ItemsSource="{Binding PointTypes}"
                                    SelectedItem="{Binding Type}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!--  X  -->
                        <DataGridTextColumn
                        Width="*"
                        Binding="{Binding X, StringFormat={}{0:0.00}}"
                        Header="X (px)"
                        IsReadOnly="True" />

                        <!--  Y  -->
                        <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Y, StringFormat={}{0:0.00}}"
                        Header="Y (px)"
                        IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

            <!--  List of Links  -->
            <TextBlock
            Grid.Row="13"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,5"
            Text="Links">
                <TextBlock.IsVisible>
                    <Binding Path="RearSuspension.IsLinkageMode" />
                </TextBlock.IsVisible>
            </TextBlock>
            <ScrollViewer
            Grid.Row="14"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="2,0,2,5">

                <DataGrid
                x:DataType="vm:LinkageWorkspaceViewModel"
                BeginningEdit="DataGrid_OnBeginningEdit"
                BorderBrush="Gray"
                BorderThickness="1"
                DataContext="{Binding Linkage}"
                GridLinesVisibility="All"
                ItemsSource="{Binding LinkViewModels}"
                SelectedItem="{Binding SelectedLink}">

                    <DataGrid.IsVisible>
                        <Binding Path="IsLinkageMode" />
                    </DataGrid.IsVisible>

                    <DataGrid.KeyBindings>
                        <KeyBinding Command="{Binding DeleteSelectedItemCommand}" Gesture="{shortcuts:ShortcutGesture Source=DesktopViews.Items.BikeImageControlsDesktopView, Id=delete-selection}" />
                    </DataGrid.KeyBindings>

                    <DataGrid.Columns>

                        <!--  Point A  -->
                        <DataGridTemplateColumn
                        Width="*"
                        Header="Point A"
                        IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vml:LinkRowViewModel">
                                    <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding A.Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="vml:LinkRowViewModel">
                                    <ComboBox
                                    HorizontalAlignment="Stretch"
                                    IsDropDownOpen="True"
                                    ItemsSource="{Binding JointOptions}"
                                    SelectedItem="{Binding A}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!--  Point B  -->
                        <DataGridTemplateColumn
                        Width="*"
                        Header="Point B"
                        IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vml:LinkRowViewModel">
                                    <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding B.Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="vml:LinkRowViewModel">
                                    <ComboBox
                                    HorizontalAlignment="Stretch"
                                    IsDropDownOpen="True"
                                    ItemsSource="{Binding JointOptions}"
                                    SelectedItem="{Binding B}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!--  Length  -->
                        <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Length, StringFormat={}{0:0.00}}"
                        Header="L (mm)"
                        IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
            <Button
            Grid.Row="15"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            x:DataType="vm:LinkageWorkspaceViewModel"
            DataContext="{Binding Linkage}"
            Command="{Binding CreateLinkCommand}"
            Content="Add new link">
                <Button.IsVisible>
                    <Binding Path="IsLinkageMode" />
                </Button.IsVisible>
            </Button>

            <Border
            Grid.Row="11"
            Grid.RowSpan="5"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding RearSuspension.IsLeverageRatioMode}">
                <editorViews:LeverageRatioEditorView DataContext="{Binding LeverageRatioEditor}" />
            </Border>

            <!--  Leverage ratio plot  -->
            <Grid
            Name="LeverageRatioPlotGrid"
            Grid.Row="16"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding Frame.HasRearSuspension}"
            Height="250">

                <zoom:PlotZoomContainer>
                    <plots:LeverageRatioPlotView
                    HorizontalAlignment="Stretch"
                    IsHitTestVisible="False"
                    LeverageRatioData="{Binding Analysis.LeverageRatioData}" />
                </zoom:PlotZoomContainer>

                <Panel
                Background="#0d0d0d"
                IsHitTestVisible="True"
                IsVisible="{Binding Analysis.IsPlotBusy}"
                Opacity="0.4" />

                <progRing:ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource SufniAccentPrimary}">
                    <progRing:ProgressRing.IsActive>
                        <Binding Path="Analysis.IsPlotBusy" />
                    </progRing:ProgressRing.IsActive>
                </progRing:ProgressRing>
            </Grid>

            <controls:ErrorMessagesBar
            Grid.Row="17"
            Grid.Column="0"
            Grid.ColumnSpan="2" />


            <!--  Export  -->
            <Button
            Grid.Row="18"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding ExportCommand}"
            Content="Export as JSON" />

            <Button
            Grid.Row="19"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding SaveCommand}"
            Content="Save" />
        </Grid>
    </ScrollViewer>
</UserControl>
