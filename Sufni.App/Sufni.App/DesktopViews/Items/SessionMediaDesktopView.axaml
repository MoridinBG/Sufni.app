<UserControl
x:Class="Sufni.App.DesktopViews.Items.SessionMediaDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:controls="clr-namespace:Sufni.App.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:desktopControls="clr-namespace:Sufni.App.DesktopViews.Controls"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:v="clr-namespace:Sufni.App.Views"
xmlns:vm="clr-namespace:Sufni.App.ViewModels.Editors"
d:DesignHeight="450"
d:DesignWidth="320"
x:Name="Root"
x:DataType="vm:ISessionMediaWorkspace"
mc:Ignorable="d">

    <Grid
        x:Name="MediaContentRoot"
        IsVisible="{Binding HasMediaContent}">

        <desktopControls:CollapsibleSplitView
            x:Name="PrimaryMediaSplit"
            FirstPaneLabel="media"
            Orientation="Vertical"
            SecondPaneLabel="map and extension media">

            <desktopControls:CollapsibleSplitView.FirstContent>
                <controls:PlaceholderOverlayContainer x:Name="MediaHost" PresentationState="{Binding MediaPaneState}">
                    <controls:PlaceholderOverlayContainer.ReadyContent>
                        <Border Background="DarkSlateBlue" />
                    </controls:PlaceholderOverlayContainer.ReadyContent>
                    <controls:PlaceholderOverlayContainer.PlaceholderContent>
                        <controls:SurfacePlaceholderCard Title="Media" PreviewBrush="DarkSlateBlue" />
                    </controls:PlaceholderOverlayContainer.PlaceholderContent>
                </controls:PlaceholderOverlayContainer>
            </desktopControls:CollapsibleSplitView.FirstContent>

            <desktopControls:CollapsibleSplitView.SecondContent>
                <desktopControls:CollapsibleSplitView
                    x:Name="LowerMediaSplit"
                    FirstPaneLabel="map"
                    Orientation="Vertical"
                    SecondPaneLabel="extension media">

                    <desktopControls:CollapsibleSplitView.FirstContent>
                        <controls:PlaceholderOverlayContainer
                            x:Name="MapHost"
                            IsVisible="{Binding MapState.ReservesLayout}"
                            PresentationState="{Binding MapState}">
                            <controls:PlaceholderOverlayContainer.ReadyContent>
                                <v:MapView
                                    x:Name="MapViewControl"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    DataContext="{Binding MapViewModel}"
                                    ExtensionSlots="{Binding $parent[controls:PlaceholderOverlayContainer].((vm:ISessionMediaWorkspace)DataContext).ExtensionSlots}"
                                    Timeline="{Binding $parent[controls:PlaceholderOverlayContainer].((vm:ISessionMediaWorkspace)DataContext).Timeline}" />
                            </controls:PlaceholderOverlayContainer.ReadyContent>
                            <controls:PlaceholderOverlayContainer.PlaceholderContent>
                                <controls:SurfacePlaceholderCard Title="Map" />
                            </controls:PlaceholderOverlayContainer.PlaceholderContent>
                        </controls:PlaceholderOverlayContainer>
                    </desktopControls:CollapsibleSplitView.FirstContent>

                    <desktopControls:CollapsibleSplitView.SecondContent>
                        <controls:RecordedSessionMediaPanesView
                            x:Name="MediaPanesHost"
                            ExtensionSlots="{Binding ExtensionSlots}" />
                    </desktopControls:CollapsibleSplitView.SecondContent>
                </desktopControls:CollapsibleSplitView>
            </desktopControls:CollapsibleSplitView.SecondContent>
        </desktopControls:CollapsibleSplitView>
    </Grid>
</UserControl>
