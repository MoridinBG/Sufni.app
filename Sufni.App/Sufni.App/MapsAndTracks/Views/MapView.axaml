<UserControl
    x:Class="Sufni.App.MapsAndTracks.Views.MapView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sufni.App.Shared.Views.Controls"
    xmlns:models="using:Sufni.App.MapsAndTracks.Models"
    xmlns:vm="using:Sufni.App.MapsAndTracks.ViewModels"
    x:DataType="vm:MapViewModel">
    <UserControl.Styles>
        <Style Selector="#TerrainLegend Button.hidden">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ContentControl Name="MapHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <Border Name="TerrainLegend" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                Padding="{StaticResource SufniMapOverlayPadding}" Background="{DynamicResource SufniMapOverlaySurface}"
                CornerRadius="{StaticResource SufniMapOverlayCornerRadius}" Opacity="{StaticResource SufniMapOverlayOpacity}"
                IsVisible="{Binding !TerrainRuns.IsEmpty}">
            <ItemsControl ItemsSource="{Binding TerrainLegend}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MapLegendEntry">
                        <Button Classes="embedded" Classes.hidden="{Binding !IsShown}" Padding="0"
                                Command="{Binding Toggle}" AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                        IsVisible="{Binding !IsUnclassified}">
                                    <Border.Background><SolidColorBrush Color="{Binding Colour}" /></Border.Background>
                                </Border>
                                <Line StartPoint="0,5" EndPoint="10,5" Width="10" Height="10" VerticalAlignment="Center"
                                      StrokeThickness="2" StrokeDashArray="1.5,1" IsVisible="{Binding IsUnclassified}">
                                    <Line.Stroke><SolidColorBrush Color="{Binding Colour}" /></Line.Stroke>
                                </Line>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SufniMapOverlayText}"
                                           FontSize="{StaticResource SufniFontSizeSmall}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="10" Padding="{StaticResource SufniMapOverlayPadding}"
                Background="{DynamicResource SufniMapOverlaySurface}"
                CornerRadius="{StaticResource SufniMapOverlayCornerRadius}" Opacity="{StaticResource SufniMapOverlayOpacity}">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <ComboBox Name="TileProviderComboBox"
                          MinWidth="120"
                          Foreground="{DynamicResource SufniMapOverlayText}"
                          PlaceholderText="Select Map..."
                          ItemsSource="{Binding AvailableLayers}"
                          SelectedItem="{Binding SelectedLayer, Mode=OneWay}"
                          SelectionChanged="TileProviderComboBox_OnSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TileLayerConfig">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Name="TrackColoringComboBox"
                          IsVisible="{Binding SupportsTerrainColoring}" IsEnabled="{Binding HasTerrain}"
                          ItemsSource="{x:Static vm:MapViewModel.Colorings}" SelectedItem="{Binding TrackColoring, Mode=TwoWay}"
                          ToolTip.Tip="Track colouring" AutomationProperties.Name="Track colouring" />
                <Button Name="AddCustomTileButton" 
                        Content="+" 
                        Foreground="{DynamicResource SufniMapOverlayText}"
                        Padding="10,0" 
                        FontWeight="Bold"
                        Command="{Binding AddCustomLayerCommand}"/>
            </StackPanel>
        </Border>
        <controls:ErrorMessagesBar Name="MapErrorMessagesBar"
                                   VerticalAlignment="Top" Margin="10" />
    </Grid>
</UserControl>
