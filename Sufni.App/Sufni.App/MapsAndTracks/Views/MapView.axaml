<UserControl
    x:Class="Sufni.App.MapsAndTracks.Views.MapView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sufni.App.Shared.Views.Controls"
    xmlns:models="using:Sufni.App.MapsAndTracks.Models"
    xmlns:vm="using:Sufni.App.MapsAndTracks.ViewModels"
    x:DataType="vm:MapViewModel">

    <Grid>
        <ContentControl Name="MapHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="10" Padding="{StaticResource SufniMapOverlayPadding}"
                Background="{DynamicResource SufniMapOverlaySurface}"
                CornerRadius="{StaticResource SufniMapOverlayCornerRadius}" Opacity="{StaticResource SufniMapOverlayOpacity}">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <ComboBox Name="TileProviderComboBox"
                          MinWidth="120"
                          Foreground="{DynamicResource SufniMapOverlayText}"
                          PlaceholderText="Select Map..."
                          ItemsSource="{Binding AvailableLayers}"
                          SelectedItem="{Binding SelectedLayer, Mode=OneWay}"
                          SelectionChanged="TileProviderComboBox_OnSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TileLayerConfig">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Name="AddCustomTileButton" 
                        Content="+" 
                        Foreground="{DynamicResource SufniMapOverlayText}"
                        Padding="10,0" 
                        FontWeight="Bold"
                        Command="{Binding AddCustomLayerCommand}"/>
            </StackPanel>
        </Border>
        <controls:ErrorMessagesBar Name="MapErrorMessagesBar"
                                   VerticalAlignment="Top" Margin="10" />
    </Grid>
</UserControl>
