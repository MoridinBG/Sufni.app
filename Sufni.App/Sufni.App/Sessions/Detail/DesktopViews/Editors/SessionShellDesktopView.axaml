<UserControl
x:Class="Sufni.App.Sessions.Detail.DesktopViews.Editors.SessionShellDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:desktopControls="clr-namespace:Sufni.App.Shared.DesktopViews.Controls"
xmlns:editors="clr-namespace:Sufni.App.Sessions.Detail.DesktopViews.Editors"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:models="clr-namespace:Sufni.App.Infrastructure"
d:DesignHeight="800"
d:DesignWidth="800"
x:Name="Root"
x:DataType="editors:SessionShellDesktopView"
Background="{DynamicResource SufniSurfacePage}"
mc:Ignorable="d">

    <desktopControls:CollapsibleSplitView
        x:Name="ShellRowsSplit"
        FirstPaneId="{x:Static models:SessionLayoutPaneIds.SignalsMediaArea}"
        FirstPaneLabel="signals and media"
        Orientation="Vertical"
        SecondPaneId="{x:Static models:SessionLayoutPaneIds.AnalysisSidebarArea}"
        SecondPaneLabel="analysis and sidebar">

        <desktopControls:CollapsibleSplitView.FirstContent>
            <desktopControls:CollapsibleSplitView
                x:Name="SignalsMediaSplit"
                DefaultFirstLength="*"
                DefaultSecondLength="Auto"
                FirstPaneId="{x:Static models:SessionLayoutPaneIds.Signals}"
                FirstPaneLabel="signals"
                HasSecondPane="{Binding #Root.HasMediaContent}"
                Orientation="Horizontal"
                SecondPaneId="{x:Static models:SessionLayoutPaneIds.Media}"
                SecondPaneLabel="media">

                <desktopControls:CollapsibleSplitView.FirstContent>
                    <ContentControl Name="SignalsHost" Content="{Binding #Root.SignalsContent}" />
                </desktopControls:CollapsibleSplitView.FirstContent>

                <desktopControls:CollapsibleSplitView.SecondContent>
                    <ContentControl
                        Name="MediaHost"
                        Content="{Binding #Root.MediaContent}" />
                </desktopControls:CollapsibleSplitView.SecondContent>
            </desktopControls:CollapsibleSplitView>
        </desktopControls:CollapsibleSplitView.FirstContent>

        <desktopControls:CollapsibleSplitView.SecondContent>
            <desktopControls:CollapsibleSplitView
                x:Name="AnalysisSidebarSplit"
                DefaultFirstLength="*"
                DefaultSecondLength="400"
                FirstPaneId="{x:Static models:SessionLayoutPaneIds.Analysis}"
                FirstPaneLabel="analysis"
                Orientation="Horizontal"
                SecondPaneId="{x:Static models:SessionLayoutPaneIds.Sidebar}"
                SecondPaneLabel="sidebar">

                <desktopControls:CollapsibleSplitView.FirstContent>
                    <ContentControl Name="AnalysisHost" Content="{Binding #Root.AnalysisContent}" />
                </desktopControls:CollapsibleSplitView.FirstContent>

                <desktopControls:CollapsibleSplitView.SecondContent>
                    <Grid RowDefinitions="auto auto *">
                <ContentControl Name="ControlHost" Grid.Row="0" Content="{Binding #Root.ControlContent}" />

                <GridSplitter
                Name="ControlSplitter"
                Grid.Row="1"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"
                IsVisible="{Binding #Root.ControlContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <ContentControl Name="SidebarHost" Grid.Row="2" Content="{Binding #Root.SidebarContent}" />
                    </Grid>
                </desktopControls:CollapsibleSplitView.SecondContent>
            </desktopControls:CollapsibleSplitView>
        </desktopControls:CollapsibleSplitView.SecondContent>
    </desktopControls:CollapsibleSplitView>
</UserControl>
