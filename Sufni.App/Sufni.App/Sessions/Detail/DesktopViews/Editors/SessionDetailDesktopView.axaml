<UserControl
x:Class="Sufni.App.Sessions.Detail.DesktopViews.Editors.SessionDetailDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="clr-namespace:Sufni.App.Sessions.Presentation.Views"
    xmlns:items2="clr-namespace:Sufni.App.Sessions.Detail.DesktopViews.Items"
    xmlns:items3="clr-namespace:Sufni.App.Sessions.Signals.DesktopViews.Items"
    xmlns:items4="clr-namespace:Sufni.App.Sessions.Media.DesktopViews.Items"
xmlns:controls="using:Sufni.App.Shared.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:editors="clr-namespace:Sufni.App.Sessions.Detail.DesktopViews.Editors"
xmlns:items="clr-namespace:Sufni.App.Sessions.Analysis.DesktopViews.Items"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:overlays="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Detail.ViewModels.Editors"
xmlns:lifecycle="clr-namespace:Sufni.App.Shared.Views"
d:DesignHeight="800"
d:DesignWidth="800"
x:Name="Root"
x:DataType="vm:SessionDetailViewModel"
Background="{DynamicResource SufniSurfacePage}"
lifecycle:ViewLifecycle.LoadedCommand="{Binding LoadedCommand}"
mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TabStripItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SufniTabText}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SufniTabText}" />
        </Style>
        <Style Selector="TabStripItem:selected">
            <Setter Property="Background" Value="{DynamicResource SufniTabSurfaceSelected}" />
        </Style>
        <Style Selector="TabItem /template/ ContentPresenter">
            <!--  Adjust text vertical position by selected pipe height  -->
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SufniTabTextHover}" />
        </Style>
        <Style Selector="TabStripItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SufniTabSurfaceHover}" />
        </Style>
        <Style Selector="TabStripItem:pointerover:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SufniTabSurfaceSelected}" />
        </Style>
        <Style Selector="TabStripItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource SufniAccentIndicatorTabUnderline}" />
            <Setter Property="Height" Value="{StaticResource SufniSelectionIndicatorThickness}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <editors:SessionShellDesktopView
            HasMediaContent="{Binding MediaWorkspace.HasMediaContent}"
            IsVisible="{Binding ScreenState.IsReady}"
            LayoutPreferences="{Binding LayoutPreferences, Mode=TwoWay}">

            <editors:SessionShellDesktopView.SignalsContent>
                <items3:RecordedSessionSignalsDesktopView DataContext="{Binding $parent[UserControl].((vm:SessionDetailViewModel)DataContext).SignalsWorkspace}" />
            </editors:SessionShellDesktopView.SignalsContent>

            <editors:SessionShellDesktopView.MediaContent>
                <items4:SessionMediaDesktopView
                    DataContext="{Binding $parent[UserControl].((vm:SessionDetailViewModel)DataContext).MediaWorkspace}"
                    LayoutPreferences="{Binding $parent[UserControl].((vm:SessionDetailViewModel)DataContext).MediaLayoutPreferences, Mode=TwoWay}" />
            </editors:SessionShellDesktopView.MediaContent>

            <editors:SessionShellDesktopView.AnalysisContent>
                <items:SessionAnalysisDesktopView DataContext="{Binding $parent[UserControl].((vm:SessionDetailViewModel)DataContext).AnalysisWorkspace}" />
            </editors:SessionShellDesktopView.AnalysisContent>

            <editors:SessionShellDesktopView.SidebarContent>
                <items2:SessionSidebarDesktopView DataContext="{Binding $parent[UserControl].((vm:SessionDetailViewModel)DataContext).SidebarWorkspace}" />
            </editors:SessionShellDesktopView.SidebarContent>
        </editors:SessionShellDesktopView>

        <presentation:SessionScreenStateOverlay Name="ScreenOverlay" ScreenState="{Binding ScreenState}" />

        <Border
            Background="{DynamicResource SufniSurfacePage}"
            IsHitTestVisible="False"
            IsVisible="{Binding SessionOperationState.IsVisible}"
            Opacity="0.35" />

        <Border
            Name="SessionOperationOverlay"
            MinWidth="180"
            MaxWidth="260"
            Padding="16,14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource SufniFieldSurface}"
            BorderBrush="{DynamicResource SufniFieldBorder}"
            BorderThickness="1"
            CornerRadius="6"
            IsHitTestVisible="False"
            IsVisible="{Binding SessionOperationState.IsVisible}">
            <StackPanel Spacing="10">
                <ProgressBar
                    Name="SessionOperationProgressBar"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding SessionOperationState.Percent}" />

                <TextBlock
                    Name="SessionOperationOverlayMessage"
                    HorizontalAlignment="Center"
                    Text="{Binding SessionOperationState.Message}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>



        <controls:ErrorMessagesBar
            Name="SessionErrorMessagesBar"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            MaxWidth="720" />
    </Grid>

</UserControl>
