<UserControl
    x:Class="Sufni.App.Sessions.Detail.Views.Editors.SessionDetailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:Sufni.App.Sessions.Detail.Views.Editors"
    xmlns:vm="clr-namespace:Sufni.App.Sessions.Detail.ViewModels.Editors"
    d:DesignHeight="600"
    d:DesignWidth="500"
    x:DataType="vm:SessionDetailViewModel"
    Background="{DynamicResource SufniRegion}"
    Focusable="True"
    mc:Ignorable="d">

    <v:SessionShellMobileView
        x:Name="MobileShell" />
</UserControl>
