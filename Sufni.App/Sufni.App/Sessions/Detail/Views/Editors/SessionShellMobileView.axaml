<UserControl
    x:Class="Sufni.App.Sessions.Detail.Views.Editors.SessionShellMobileView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="clr-namespace:Sufni.App.Sessions.Presentation.Views"
    xmlns:overlays="clr-namespace:Sufni.App.Shared.Views.Overlays"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:Sufni.App.Shared.Views.Controls"
    xmlns:vm="clr-namespace:Sufni.App.Sessions.Presentation"
    xmlns:vmp="clr-namespace:Sufni.App.Sessions.Pages.ViewModels.SessionPages"
    xmlns:vme="clr-namespace:Sufni.App.Sessions.Detail.Views.Editors"
    xmlns:lifecycle="clr-namespace:Sufni.App.Shared.Views"
    d:DesignHeight="600"
    d:DesignWidth="500"
    x:DataType="vm:ISessionShellMobileWorkspace"
    Background="{DynamicResource SufniSurfacePage}"
    Focusable="True"
    lifecycle:ViewLifecycle.UnloadedCommand="{Binding $self.UnloadedCommand}"
    mc:Ignorable="d">

    <Grid>
        <Grid Margin="12,8,12,6" IsVisible="{Binding ScreenState.IsReady}" RowDefinitions="auto auto * auto auto auto auto">

            <!--  Name  -->
            <v:EditableTitle
                Grid.Row="0"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                DataContext="{Binding Editor}" />

            <TextBlock
                Grid.Row="1"
                Name="SelectedPageHeader"
                Margin="2,0,2,6"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource SufniTextSecondary}"
                Text="{Binding SelectedPageDisplayName}" />

            <CarouselPage
                Name="SessionCarouselPage"
                Grid.Row="2"
                Background="{DynamicResource SufniSurfacePage}"
                ItemsSource="{Binding Pages}"
                SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                lifecycle:ViewLifecycle.LoadedCommand="{Binding $parent[vme:SessionShellMobileView].LoadedCommand}"
                lifecycle:ViewLifecycle.LoadedCommandParameter="{Binding ElementName=SessionCarouselPage, Path=Bounds}">
                <CarouselPage.PageTemplate>
                    <DataTemplate x:DataType="vmp:PageViewModelBase">
                        <ContentPage
                            Header="{Binding DisplayName}"
                            Content="{Binding}"
                            Background="{DynamicResource SufniSurfacePage}"
                            AutomaticallyApplySafeAreaPadding="False" />
                    </DataTemplate>
                </CarouselPage.PageTemplate>
            </CarouselPage>

            <PipsPager
                Name="SessionPipsPager"
                Grid.Row="3"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                MaxVisiblePips="7"
                NumberOfPages="{Binding PageCount}"
                SelectedPageIndex="{Binding SelectedPageIndex, Mode=TwoWay}" />

            <!--  Error messages for Session instance  -->
            <v:ErrorMessagesBar Grid.Row="4" Margin="4,4,4,0" DataContext="{Binding Editor}" />

            <!--  Optional live-only control content slot (sticky band)  -->
            <ContentControl
                Name="ShellControlContent"
                Grid.Row="5"
                Margin="4,4,4,0"
                Content="{Binding $parent[vme:SessionShellMobileView].ControlContent}"
                IsVisible="{Binding $parent[vme:SessionShellMobileView].ControlContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!--  Back, Save, Reset and Delete buttons  -->
            <v:CommonButtonLine Grid.Row="6" Margin="0,4,0,0" DataContext="{Binding Editor}" />
        </Grid>

        <presentation:SessionScreenStateOverlay Name="ScreenOverlay" ScreenState="{Binding ScreenState}" LoadingFallbackMessage="Loading session data..." />

        <overlays:BusyOverlay
            Name="SessionOperationBusyOverlay"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IndicatorForeground="{DynamicResource SufniAccentPrimary}"
            IsActive="{Binding SessionOperationState.IsVisible}"
            IsVisible="{Binding SessionOperationState.IsVisible}"
            Message="{Binding SessionOperationState.Message}"
            MessageForeground="{DynamicResource SufniAccentPrimary}"
            ProgressValue="{Binding SessionOperationState.ProgressFraction}"
            ShowProgress="True"
            ShowTint="True"
            TintBackground="{DynamicResource SufniSurfacePage}"
            TintOpacity="0.35"
            UseStackLayout="True" />


    </Grid>
</UserControl>
