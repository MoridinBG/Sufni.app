<UserControl
x:Class="Sufni.App.Sessions.Insights.Views.Controls.SessionInsightsStepView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:converters="clr-namespace:Sufni.App.Sessions.Insights.Views.Converters"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:models="clr-namespace:Sufni.App.Sessions.Models"
d:DesignHeight="260"
d:DesignWidth="720"
x:DataType="models:SessionInsightsStep"
mc:Ignorable="d">

    <UserControl.Resources>
        <converters:SessionInsightsToneToBrushConverter x:Key="ToneToBrush" />
    </UserControl.Resources>

    <Border
    Margin="0,0,0,8"
    Padding="10"
    BorderBrush="{DynamicResource SufniLineDefaultBrush}"
    BorderThickness="1"
    CornerRadius="6">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border
                Grid.Column="0"
                Width="26"
                Height="26"
                Margin="0,0,8,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource SufniSelectionSurfaceSubtleBrush}"
                BorderBrush="{DynamicResource SufniLineDefaultBrush}"
                BorderThickness="1"
                CornerRadius="13">
                    <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Number}" />
                </Border>

                <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Text="{Binding Title}"
                TextWrapping="Wrap" />

                <Border
                Grid.Column="2"
                Margin="8,0,0,0"
                Padding="8,3"
                VerticalAlignment="Center"
                BorderBrush="{Binding VerdictTone, Converter={StaticResource ToneToBrush}}"
                BorderThickness="1"
                CornerRadius="4">
                    <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding VerdictTone, Converter={StaticResource ToneToBrush}}"
                    Text="{Binding VerdictText}" />
                </Border>
            </Grid>

            <TextBlock
            Name="GatingMessageTextBlock"
            FontSize="12"
            FontStyle="Italic"
            Opacity="0.85"
            IsVisible="{Binding HasGatingMessage}"
            Text="{Binding GatingMessage}"
            TextWrapping="Wrap" />

            <ItemsControl Name="StepMetricsItemsControl" ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionInsightsMetric">
                        <Border
                        Margin="0,0,6,6"
                        Padding="6,4"
                        BorderBrush="{DynamicResource SufniLineSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        ToolTip.Tip="{Binding Tooltip}">
                            <StackPanel>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Label}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                    IsVisible="{Binding HasStatusGlyph}"
                                    Text="{Binding StatusGlyph}" />
                                    <TextBlock FontSize="12" Text="{Binding DisplayValue}" />
                                </StackPanel>
                                <TextBlock FontSize="10" Opacity="0.7" Text="{Binding TargetRange, StringFormat='target: {0}'}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl
            Name="StepFindingsItemsControl"
            IsVisible="{Binding HasFindings}"
            ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionInsightsFinding">
                        <StackPanel Margin="0,2,0,6" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                Grid.Column="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />
                                <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                Text="{Binding SeverityText}" />
                            </Grid>

                            <TextBlock
                            FontSize="12"
                            Opacity="0.85"
                            Text="{Binding Observation}"
                            TextWrapping="Wrap" />

                            <StackPanel IsVisible="{Binding HasSuggestion}" Spacing="1">
                                <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding PrimarySuggestion.ExperimentText, StringFormat='→ {0}'}"
                                TextWrapping="Wrap" />
                                <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                Text="{Binding PrimarySuggestion.ExpectedEffect}"
                                TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                            FontSize="12"
                            Opacity="0.85"
                            IsVisible="{Binding !HasSuggestion}"
                            Text="{Binding Recommendation}"
                            TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
