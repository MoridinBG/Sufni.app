<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Sufni.App.Terrain.Models"
             xmlns:terrain="using:Sufni.App.Terrain.Views"
             x:Class="Sufni.App.Sessions.Insights.Views.Controls.SessionInsightsGroundComfortPanel"
             x:DataType="models:GroundComfortReport">
    <UserControl.Resources>
        <terrain:TerrainSwatchConverter x:Key="Swatch" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <Border Margin="0,4,0,0" Padding="10" BorderBrush="{DynamicResource SufniLineDefaultBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Ground &amp; comfort" />
            <TextBlock TextWrapping="Wrap"
                       Text="How the ground in scope reached you. Rougher ground moves the suspension more; the frame should stay calm." />
            <Grid Name="Levels" Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Ground" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Fork" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shock" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Frame" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="heading" Text="Level" />
                    <TextBlock Grid.Column="1" Classes="heading" Text="Ground" ToolTip.Tip="Distance on this level inside the scope." />
                    <TextBlock Grid.Column="2" Classes="heading" Text="Fork"
                               ToolTip.Tip="How much the fork moved: against your usual when it is ready, else in mm/s." />
                    <TextBlock Grid.Column="3" Classes="heading" Text="Shock"
                               ToolTip.Tip="How much the shock moved: against your usual when it is ready, else in mm/s." />
                    <TextBlock Grid.Column="4" Classes="heading" Text="Frame"
                               ToolTip.Tip="Vibration that reached the frame, as felt. Faster riding raises it." />
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Levels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:GroundComfortLevel">
                            <Grid Margin="0,3,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Ground" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Fork" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shock" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Frame" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{Binding Class, Converter={StaticResource Swatch}}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Distance}" />
                                <TextBlock Grid.Column="2" Text="{Binding Fork.Summary}" />
                                <TextBlock Grid.Column="3" Text="{Binding Shock.Summary}" />
                                <TextBlock Grid.Column="4" Text="{Binding Frame.Summary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <TextBlock Classes="note" Text="{Binding UsualNote}" IsVisible="{Binding HasUsualNote}" />
            <TextBlock Classes="note" Text="{Binding FrameNote}" IsVisible="{Binding HasFrameNote}" />
        </StackPanel>
    </Border>
</UserControl>
