<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Sufni.App.Sessions.Models"
             xmlns:terrain="using:Sufni.App.Terrain.Views"
             x:DataType="models:SessionResponsePanel"
             x:Class="Sufni.App.Sessions.Insights.Views.Controls.SessionInsightsResponsePanel"
             IsVisible="{Binding IsVisible, FallbackValue=False}">
    <StackPanel Spacing="6">
        <TextBlock Text="Bike response against your usual" FontWeight="SemiBold" />
        <TextBlock Name="Description" Text="{Binding Description}" TextWrapping="Wrap" />
        <TextBlock Name="Hint" Text="{Binding Hint}" IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" FontStyle="Italic" />
        <Panel IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNotNull}}">
            <terrain:TerrainResponseReportView Name="Report" DataContext="{Binding Report}" />
        </Panel>
    </StackPanel>
</UserControl>
