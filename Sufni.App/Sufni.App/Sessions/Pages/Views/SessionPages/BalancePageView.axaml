<UserControl
x:Class="Sufni.App.Sessions.Pages.Views.SessionPages.BalancePageView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Sufni.App.Extensibility.Views"
xmlns:controls="clr-namespace:Sufni.App.Sessions.Analysis.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Pages.ViewModels.SessionPages"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:BalancePageViewModel"
mc:Ignorable="d">

    <ScrollViewer
    x:Name="PageScrollViewer"
    ClipToBounds="True"
    HorizontalScrollBarVisibility="Disabled"
    IsScrollChainingEnabled="False">
        <StackPanel
        Name="MobileBalanceAnalysisContent"
        Width="{Binding #PageScrollViewer.Bounds.Width}"
        ClipToBounds="True"
        Orientation="Vertical"
        Spacing="8">
            <views:RecordedSessionAnalysisContributionsView ExtensionSlots="{Binding AnalysisWorkspace.ExtensionSlots}" />

            <StackPanel
            Name="MobileBalanceModeRadioButtons"
            Margin="0,8,0,0"
            IsVisible="{Binding HasAnalysisData}"
            Spacing="4">
                <StackPanel
                Name="MobileBalanceDisplacementModeRadioButtons"
                Orientation="Horizontal"
                Spacing="8">
                    <RadioButton
                    Name="MobileZenithModeRadioButton"
                    Content="Zenith"
                    GroupName="MobileBalanceDisplacementMode"
                    IsChecked="{Binding ZenithModeSelected, Mode=TwoWay}"
                    ToolTip.Tip="Uses deepest stroke travel." />
                    <RadioButton
                    Name="MobileTravelModeRadioButton"
                    Content="Travel"
                    GroupName="MobileBalanceDisplacementMode"
                    IsChecked="{Binding TravelModeSelected, Mode=TwoWay}"
                    ToolTip.Tip="Uses start-to-end stroke distance." />
                    <RadioButton
                    Name="MobileSpeedModeRadioButton"
                    Content="Speed"
                    GroupName="MobileBalanceDisplacementMode"
                    IsChecked="{Binding SpeedModeSelected, Mode=TwoWay}"
                    ToolTip.Tip="Uses travel position at peak stroke speed." />
                </StackPanel>

                <StackPanel
                Name="MobileBalanceSpeedModeRadioButtons"
                Orientation="Horizontal"
                Spacing="8">
                    <RadioButton
                    Name="MobileBothSpeedModeRadioButton"
                    Content="Both"
                    GroupName="MobileBalanceSpeedMode"
                    IsChecked="{Binding BothSpeedModeSelected, Mode=TwoWay}"
                    ToolTip.Tip="Uses all matching compression or rebound strokes." />
                    <RadioButton
                    Name="MobileLowSpeedModeRadioButton"
                    Content="Low speed"
                    GroupName="MobileBalanceSpeedMode"
                    IsChecked="{Binding LowSpeedModeSelected, Mode=TwoWay}"
                    ToolTip.Tip="Uses strokes below the high-speed threshold." />
                    <RadioButton
                    Name="MobileHighSpeedModeRadioButton"
                    Content="High speed"
                    GroupName="MobileBalanceSpeedMode"
                    IsChecked="{Binding HighSpeedModeSelected, Mode=TwoWay}"
                    ToolTip.Tip="Uses strokes at or above the high-speed threshold." />
                </StackPanel>
            </StackPanel>

            <controls:BalanceAnalysisHost
            AnalysisRange="{Binding AnalysisWorkspace.AnalysisRange}"
            AnalysisResultState="{Binding AnalysisWorkspace.AnalysisResultState}"
            BalanceDisplacementMode="{Binding AnalysisWorkspace.SelectedBalanceDisplacementMode}"
            BalanceSpeedMode="{Binding AnalysisWorkspace.SelectedBalanceSpeedMode}"
            BalanceType="Compression"
            DampingSpeedCutoffs="{Binding AnalysisWorkspace.DampingSpeedCutoffs}"
            ExtensionSlots="{Binding AnalysisWorkspace.ExtensionSlots}"
            HasAnalysisData="{Binding HasAnalysisData}"
            MinCardHeight="220"
            PlaceholderMargin="0,0,0,12"
            PlotName="CompressionBalancePlot"
            PlotHeight="380"
            PlotDampingSpeedCutoffs="{Binding AnalysisWorkspace.PlotDampingSpeedCutoffs}"
            PresentationState="{Binding CompressionPresentationState}"
            StaticSource="{Binding CompressionBalance}"
            StaticSourceName="CompressionBalanceSvg"
            Telemetry="{Binding AnalysisWorkspace.TelemetryData}"
            Title="Compression balance" />

            <controls:BalanceAnalysisHost
            AnalysisRange="{Binding AnalysisWorkspace.AnalysisRange}"
            AnalysisResultState="{Binding AnalysisWorkspace.AnalysisResultState}"
            BalanceDisplacementMode="{Binding AnalysisWorkspace.SelectedBalanceDisplacementMode}"
            BalanceSpeedMode="{Binding AnalysisWorkspace.SelectedBalanceSpeedMode}"
            BalanceType="Rebound"
            DampingSpeedCutoffs="{Binding AnalysisWorkspace.DampingSpeedCutoffs}"
            ExtensionSlots="{Binding AnalysisWorkspace.ExtensionSlots}"
            HasAnalysisData="{Binding HasAnalysisData}"
            MinCardHeight="220"
            PlotName="ReboundBalancePlot"
            PlotHeight="380"
            PlotDampingSpeedCutoffs="{Binding AnalysisWorkspace.PlotDampingSpeedCutoffs}"
            PresentationState="{Binding ReboundPresentationState}"
            StaticSource="{Binding ReboundBalance}"
            StaticSourceName="ReboundBalanceSvg"
            Telemetry="{Binding AnalysisWorkspace.TelemetryData}"
            Title="Rebound balance" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
