<UserControl
x:Class="Sufni.App.Sessions.Pages.Views.SessionPages.SpringPageView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls2="clr-namespace:Sufni.App.Sessions.Analysis.Views.Controls"
xmlns:controls="clr-namespace:Sufni.App.Extensibility.Views"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Pages.ViewModels.SessionPages"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:SpringPageViewModel"
mc:Ignorable="d">

    <ScrollViewer
    x:Name="PageScrollViewer"
    Width="{Binding $parent[ScrollViewer].Bounds.Width}"
    ClipToBounds="True"
    HorizontalScrollBarVisibility="Disabled"
    IsScrollChainingEnabled="False">
        <StackPanel
        Name="MobileSpringAnalysisContent"
        Width="{Binding #PageScrollViewer.Bounds.Width}"
        ClipToBounds="True"
        Orientation="Vertical"
        Spacing="8">
            <controls:RecordedSessionAnalysisContributionsView ExtensionSlots="{Binding AnalysisWorkspace.ExtensionSlots}" />

            <StackPanel
            Name="MobileTravelDistributionModeRadioButtons"
            Margin="0,8,0,0"
            IsVisible="{Binding HasAnalysisData}"
            Spacing="4">
                <RadioButton
                Name="MobileActiveSuspensionModeRadioButton"
                Content="Active suspension"
                GroupName="MobileTravelDistributionMode"
                IsChecked="{Binding ActiveSuspensionModeSelected, Mode=TwoWay}"
                ToolTip.Tip="Uses only compression and rebound stroke samples. Best for travel use while the suspension is actively moving." />
                <RadioButton
                Name="MobileDynamicSagModeRadioButton"
                Content="Dynamic sag"
                GroupName="MobileTravelDistributionMode"
                IsChecked="{Binding DynamicSagModeSelected, Mode=TwoWay}"
                ToolTip.Tip="Uses every selected travel sample. Best for ride height over the segment, including quiet or steady sections." />
            </StackPanel>

            <controls2:TravelAnalysisHost
            AnalysisRange="{Binding AnalysisWorkspace.AnalysisRange}"
            AnalysisResultState="{Binding AnalysisWorkspace.AnalysisResultState}"
            ExtensionSlots="{Binding AnalysisWorkspace.ExtensionSlots}"
            HasAnalysisData="{Binding HasAnalysisData}"
            MinCardHeight="220"
            PlaceholderMargin="0,0,0,12"
            PlotHeight="260"
            PresentationState="{Binding FrontPresentationState}"
            StaticSource="{Binding FrontTravelDistribution}"
            SuspensionType="Front"
            Telemetry="{Binding AnalysisWorkspace.TelemetryData}"
            Title="Front travel distribution"
            TravelDistributionMode="{Binding AnalysisWorkspace.SelectedTravelDistributionMode}" />

            <controls2:TravelAnalysisHost
            AnalysisRange="{Binding AnalysisWorkspace.AnalysisRange}"
            AnalysisResultState="{Binding AnalysisWorkspace.AnalysisResultState}"
            ExtensionSlots="{Binding AnalysisWorkspace.ExtensionSlots}"
            HasAnalysisData="{Binding HasAnalysisData}"
            MinCardHeight="220"
            PlotHeight="260"
            PresentationState="{Binding RearPresentationState}"
            StaticSource="{Binding RearTravelDistribution}"
            SuspensionType="Rear"
            Telemetry="{Binding AnalysisWorkspace.TelemetryData}"
            Title="Rear travel distribution"
            TravelDistributionMode="{Binding AnalysisWorkspace.SelectedTravelDistributionMode}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
