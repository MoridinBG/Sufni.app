<UserControl
x:Class="Sufni.App.Sessions.Pages.Views.SessionPages.StrokesPageView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls2="clr-namespace:Sufni.App.Sessions.Analysis.Views.Controls"
xmlns:controls="clr-namespace:Sufni.App.Extensibility.Views"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Pages.ViewModels.SessionPages"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:StrokesPageViewModel"
mc:Ignorable="d">

    <ScrollViewer
    x:Name="PageScrollViewer"
    Width="{Binding $parent[ScrollViewer].Bounds.Width}"
    ClipToBounds="True"
    HorizontalScrollBarVisibility="Disabled"
    IsScrollChainingEnabled="False">
        <StackPanel
        Name="MobileStrokesAnalysisContent"
        Width="{Binding #PageScrollViewer.Bounds.Width}"
        ClipToBounds="True"
        Spacing="8">
            <controls:RecordedSessionAnalysisContributionsView ExtensionSlots="{Binding Workspace.ExtensionSlots}" />

            <StackPanel
            Name="MobileStrokesSideRadioButtons"
            Margin="0,8,0,0"
            IsVisible="{Binding HasBothAnalysisSides}"
            Spacing="4">
                <RadioButton
                Name="MobileFrontStrokesSideRadioButton"
                Content="Front"
                GroupName="MobileStrokesSide"
                IsChecked="{Binding FrontSideSelected, Mode=TwoWay}" />
                <RadioButton
                Name="MobileRearStrokesSideRadioButton"
                Content="Rear"
                GroupName="MobileStrokesSide"
                IsChecked="{Binding RearSideSelected, Mode=TwoWay}" />
            </StackPanel>

            <Grid Name="FrontStrokesPanel" IsVisible="{Binding ShowFrontStrokes}">
                <controls2:StrokeAnalysisHost
                AnalysisRange="{Binding Workspace.AnalysisRange}"
                AnalysisResultState="{Binding Workspace.AnalysisResultState}"
                CompressionLengthRowHeight="260"
                CompressionSpeedRowHeight="260"
                DeepTravelRowHeight="220"
                ExtensionSlots="{Binding Workspace.ExtensionSlots}"
                MinCardHeight="260"
                PresentationState="{Binding Workspace.FrontAnalysisState}"
                ReboundLengthRowHeight="260"
                ReboundSpeedRowHeight="260"
                SelectAnalysisRangeCommand="{Binding Workspace.SelectAnalysisRangeCommand}"
                ActiveFrontAnalysisSelection="{Binding Workspace.ActiveFrontAnalysisSelection}"
                ActiveRearAnalysisSelection="{Binding Workspace.ActiveRearAnalysisSelection}"
                SuspensionType="Front"
                Telemetry="{Binding Workspace.TelemetryData}"
                Title="Front strokes" />
            </Grid>

            <Grid Name="RearStrokesPanel" IsVisible="{Binding ShowRearStrokes}">
                <controls2:StrokeAnalysisHost
                AnalysisRange="{Binding Workspace.AnalysisRange}"
                AnalysisResultState="{Binding Workspace.AnalysisResultState}"
                CompressionLengthRowHeight="260"
                CompressionSpeedRowHeight="260"
                DeepTravelRowHeight="220"
                ExtensionSlots="{Binding Workspace.ExtensionSlots}"
                MinCardHeight="260"
                PresentationState="{Binding Workspace.RearAnalysisState}"
                ReboundLengthRowHeight="260"
                ReboundSpeedRowHeight="260"
                SelectAnalysisRangeCommand="{Binding Workspace.SelectAnalysisRangeCommand}"
                ActiveFrontAnalysisSelection="{Binding Workspace.ActiveFrontAnalysisSelection}"
                ActiveRearAnalysisSelection="{Binding Workspace.ActiveRearAnalysisSelection}"
                SuspensionType="Rear"
                Telemetry="{Binding Workspace.TelemetryData}"
                Title="Rear strokes" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
