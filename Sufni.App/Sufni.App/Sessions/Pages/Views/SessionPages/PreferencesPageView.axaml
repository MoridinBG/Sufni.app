<UserControl
x:Class="Sufni.App.Sessions.Pages.Views.SessionPages.PreferencesPageView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Pages.ViewModels.SessionPages"
d:DesignHeight="220"
d:DesignWidth="320"
x:DataType="vm:PreferencesPageViewModel"
mc:Ignorable="d">

    <ScrollViewer
    Width="{Binding $parent[ScrollViewer].Bounds.Width}"
    Padding="15,10,15,10"
    IsScrollChainingEnabled="False">
        <StackPanel Spacing="8">
        <TextBlock
        FontSize="14"
        FontWeight="SemiBold"
        Text="Signals" />

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Left"
            FontSize="12"
            Text="Smoothing" />
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Name="TravelSignalLabel"
            VerticalAlignment="Center"
            Text="{Binding TravelSignal.DisplayName}"
            IsEnabled="{Binding TravelSignal.Available}" />

            <ComboBox
            Name="TravelSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding TravelSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding TravelSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}"
            ToolTip.Tip="Smooths only how this signal is drawn; it does not change the recorded data or the analysis.">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Name="VelocitySignalLabel"
            VerticalAlignment="Center"
            Text="{Binding VelocitySignal.DisplayName}"
            IsEnabled="{Binding VelocitySignal.Available}" />

            <ComboBox
            Name="VelocitySignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding VelocitySignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding VelocitySignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}"
            ToolTip.Tip="Smooths only how this signal is drawn; it does not change the recorded data or the analysis.">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Name="ImuSignalLabel"
            VerticalAlignment="Center"
            Text="{Binding ImuSignal.DisplayName}"
            IsEnabled="{Binding ImuSignal.Available}" />

            <ComboBox
            Name="ImuSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding ImuSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding ImuSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}"
            ToolTip.Tip="Smooths only how this signal is drawn; it does not change the recorded data or the analysis.">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Name="PitchRollSignalLabel"
            VerticalAlignment="Center"
            Text="{Binding PitchRollSignal.DisplayName}"
            IsEnabled="{Binding PitchRollSignal.Available}" />

            <ComboBox
            Name="PitchRollSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding PitchRollSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding PitchRollSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}"
            ToolTip.Tip="Smooths only how this signal is drawn; it does not change the recorded data or the analysis.">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Name="SpeedSignalLabel"
            VerticalAlignment="Center"
            Text="{Binding SpeedSignal.DisplayName}"
            IsEnabled="{Binding SpeedSignal.Available}" />

            <ComboBox
            Name="SpeedSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding SpeedSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding SpeedSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}"
            ToolTip.Tip="Smooths only how this signal is drawn; it does not change the recorded data or the analysis.">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Name="ElevationSignalLabel"
            VerticalAlignment="Center"
            Text="{Binding ElevationSignal.DisplayName}"
            IsEnabled="{Binding ElevationSignal.Available}" />

            <ComboBox
            Name="ElevationSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding ElevationSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding ElevationSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}"
            ToolTip.Tip="Smooths only how this signal is drawn; it does not change the recorded data or the analysis.">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <TextBlock
        Margin="0,8,0,0"
        FontSize="14"
        FontWeight="SemiBold"
        Text="Processing" />

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Velocity filter" />
            <TextBlock
            Grid.Column="1"
            FontSize="12"
            Text="{Binding VelocityFilterWindowDisplay}" />
        </Grid>

        <Slider
        Name="VelocityFilterWindowSlider"
        Minimum="{Binding MinVelocityFilterWindowMilliseconds}"
        Maximum="{Binding MaxVelocityFilterWindowMilliseconds}"
        TickFrequency="10"
        IsSnapToTickEnabled="True"
        ToolTip.Tip="Suspension speed is derived from how quickly travel changes, so sensor noise and tiny bumps get exaggerated. This filter averages the speed over a short window to tame that noise before the session is recalculated. Wider windows remove more noise but blur quick, sharp events; 0 turns it off."
        Value="{Binding VelocityFilterWindowMilliseconds, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
