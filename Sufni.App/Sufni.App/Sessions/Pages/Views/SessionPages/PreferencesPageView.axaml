<UserControl
x:Class="Sufni.App.Sessions.Pages.Views.SessionPages.PreferencesPageView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Pages.ViewModels.SessionPages"
d:DesignHeight="220"
d:DesignWidth="320"
x:DataType="vm:PreferencesPageViewModel"
mc:Ignorable="d">

    <ScrollViewer
    Width="{Binding $parent[ScrollViewer].Bounds.Width}"
    Padding="15,10,15,10"
    IsScrollChainingEnabled="False">
        <StackPanel Spacing="8">
        <TextBlock
        FontSize="14"
        FontWeight="SemiBold"
        Text="Signals" />

        <Grid ColumnDefinitions="*,120">
            <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Left"
            FontSize="12"
            Text="Smoothing" />
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <CheckBox
            Name="TravelSignalCheckBox"
            Content="{Binding TravelSignal.DisplayName}"
            IsChecked="{Binding TravelSignal.Selected, Mode=TwoWay}"
            IsEnabled="{Binding TravelSignal.Available}" />

            <ComboBox
            Name="TravelSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding TravelSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding TravelSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <CheckBox
            Name="VelocitySignalCheckBox"
            Content="{Binding VelocitySignal.DisplayName}"
            IsChecked="{Binding VelocitySignal.Selected, Mode=TwoWay}"
            IsEnabled="{Binding VelocitySignal.Available}" />

            <ComboBox
            Name="VelocitySignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding VelocitySignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding VelocitySignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <CheckBox
            Name="ImuSignalCheckBox"
            Content="{Binding ImuSignal.DisplayName}"
            IsChecked="{Binding ImuSignal.Selected, Mode=TwoWay}"
            IsEnabled="{Binding ImuSignal.Available}" />

            <ComboBox
            Name="ImuSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding ImuSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding ImuSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <CheckBox
            Name="PitchRollSignalCheckBox"
            Content="{Binding PitchRollSignal.DisplayName}"
            IsChecked="{Binding PitchRollSignal.Selected, Mode=TwoWay}"
            IsEnabled="{Binding PitchRollSignal.Available}" />

            <ComboBox
            Name="PitchRollSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding PitchRollSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding PitchRollSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <CheckBox
            Name="SpeedSignalCheckBox"
            Content="{Binding SpeedSignal.DisplayName}"
            IsChecked="{Binding SpeedSignal.Selected, Mode=TwoWay}"
            IsEnabled="{Binding SpeedSignal.Available}" />

            <ComboBox
            Name="SpeedSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding SpeedSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding SpeedSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,120">
            <CheckBox
            Name="ElevationSignalCheckBox"
            Content="{Binding ElevationSignal.DisplayName}"
            IsChecked="{Binding ElevationSignal.Selected, Mode=TwoWay}"
            IsEnabled="{Binding ElevationSignal.Available}" />

            <ComboBox
            Name="ElevationSignalSmoothingComboBox"
            Grid.Column="1"
            IsEnabled="{Binding ElevationSignal.Available}"
            ItemsSource="{Binding SmoothingOptions}"
            SelectedValue="{Binding ElevationSignal.SelectedSmoothing, Mode=TwoWay}"
            SelectedValueBinding="{Binding Value, DataType=vm:SignalSmoothingOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SignalSmoothingOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <TextBlock
        Margin="0,8,0,0"
        FontSize="14"
        FontWeight="SemiBold"
        Text="Processing" />

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Velocity filter" />
            <TextBlock
            Grid.Column="1"
            FontSize="12"
            Text="{Binding VelocityFilterWindowDisplay}" />
        </Grid>

        <Slider
        Name="VelocityFilterWindowSlider"
        Minimum="{Binding MinVelocityFilterWindowMilliseconds}"
        Maximum="{Binding MaxVelocityFilterWindowMilliseconds}"
        TickFrequency="10"
        IsSnapToTickEnabled="True"
        ToolTip.Tip="Controls how much the app smooths suspension speed before recalculating the session. Higher values reduce jitter and sharp noise; 0 turns it off."
        Value="{Binding VelocityFilterWindowMilliseconds, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
