<UserControl
x:Class="Sufni.App.Sessions.Pages.Views.SessionPages.VibrationPageView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls2="clr-namespace:Sufni.App.Sessions.Analysis.Views.Controls"
xmlns:controls="clr-namespace:Sufni.App.Extensibility.Views"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Pages.ViewModels.SessionPages"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:VibrationPageViewModel"
mc:Ignorable="d">

    <ScrollViewer
    x:Name="PageScrollViewer"
    Width="{Binding $parent[ScrollViewer].Bounds.Width}"
    ClipToBounds="True"
    HorizontalScrollBarVisibility="Disabled"
    IsScrollChainingEnabled="False">
        <StackPanel
        Name="VibrationColumn"
        Width="{Binding #PageScrollViewer.Bounds.Width}"
        ClipToBounds="True"
        Spacing="10">
            <controls:RecordedSessionAnalysisContributionsView ExtensionSlots="{Binding Workspace.ExtensionSlots}" />

            <controls2:VibrationAnalysisHost
            HostName="FrontForkVibrationHost"
            AnalysisRange="{Binding Workspace.AnalysisRange}"
            AnalysisResultState="{Binding Workspace.AnalysisResultState}"
            ExtensionSlots="{Binding Workspace.ExtensionSlots}"
            ImuLocation="Fork"
            MinCardHeight="320"
            PlotRowHeight="260"
            PresentationState="{Binding Workspace.FrontForkVibrationState}"
            SuspensionType="Front"
            Telemetry="{Binding Workspace.TelemetryData}"
            Title="Front fork" />

            <controls2:VibrationAnalysisHost
            HostName="FrontFrameVibrationHost"
            AnalysisRange="{Binding Workspace.AnalysisRange}"
            AnalysisResultState="{Binding Workspace.AnalysisResultState}"
            ExtensionSlots="{Binding Workspace.ExtensionSlots}"
            ImuLocation="Frame"
            MinCardHeight="320"
            PlotRowHeight="260"
            PresentationState="{Binding Workspace.FrontFrameVibrationState}"
            SuspensionType="Front"
            Telemetry="{Binding Workspace.TelemetryData}"
            Title="Front frame" />

            <controls2:VibrationAnalysisHost
            HostName="RearForkVibrationHost"
            AnalysisRange="{Binding Workspace.AnalysisRange}"
            AnalysisResultState="{Binding Workspace.AnalysisResultState}"
            ExtensionSlots="{Binding Workspace.ExtensionSlots}"
            ImuLocation="Fork"
            MinCardHeight="320"
            PlotRowHeight="260"
            PresentationState="{Binding Workspace.RearForkVibrationState}"
            SuspensionType="Rear"
            Telemetry="{Binding Workspace.TelemetryData}"
            Title="Rear fork" />

            <controls2:VibrationAnalysisHost
            HostName="RearFrameVibrationHost"
            AnalysisRange="{Binding Workspace.AnalysisRange}"
            AnalysisResultState="{Binding Workspace.AnalysisResultState}"
            ExtensionSlots="{Binding Workspace.ExtensionSlots}"
            ImuLocation="Frame"
            MinCardHeight="320"
            PlotRowHeight="260"
            PresentationState="{Binding Workspace.RearFrameVibrationState}"
            SuspensionType="Rear"
            Telemetry="{Binding Workspace.TelemetryData}"
            Title="Rear frame" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
