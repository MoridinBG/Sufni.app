<UserControl
x:Name="Root"
x:Class="Sufni.App.Sessions.Analysis.Views.Controls.StrokeAnalysisHost"
x:DataType="analysisControls:StrokeAnalysisHost"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:analysisControls="clr-namespace:Sufni.App.Sessions.Analysis.Views.Controls"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:plots="clr-namespace:Sufni.App.Sessions.Plots.Views.Plots"
d:DesignHeight="450"
d:DesignWidth="800"
mc:Ignorable="d">

    <controls:PlaceholderOverlayContainer PresentationState="{Binding #Root.PresentationState}">
        <controls:PlaceholderOverlayContainer.ReadyContent>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding #Root.CompressionLengthRowHeight}" />
                    <RowDefinition Height="{Binding #Root.CompressionSpeedRowHeight}" />
                    <RowDefinition Height="{Binding #Root.ReboundLengthRowHeight}" />
                    <RowDefinition Height="{Binding #Root.ReboundSpeedRowHeight}" />
                    <RowDefinition Height="{Binding #Root.DeepTravelRowHeight}" />
                </Grid.RowDefinitions>

                <plots:AnalysisPlotView
                AnalysisRange="{Binding #Root.AnalysisRange}"
                BalanceType="Compression"
                ExtensionSlots="{Binding #Root.ExtensionSlots}"
                AnalysisPlotKind="StrokeLengthDistribution"
                SelectAnalysisRangeCommand="{Binding #Root.SelectAnalysisRangeCommand}"
                ActiveAnalysisSelection="{Binding #Root.ActiveAnalysisSelection}"
                SuspensionType="{Binding #Root.SuspensionType}"
                Telemetry="{Binding #Root.Telemetry}" />

                <plots:AnalysisPlotView
                AnalysisRange="{Binding #Root.AnalysisRange}"
                Grid.Row="1"
                BalanceType="Compression"
                ExtensionSlots="{Binding #Root.ExtensionSlots}"
                AnalysisPlotKind="StrokeSpeedDistribution"
                SelectAnalysisRangeCommand="{Binding #Root.SelectAnalysisRangeCommand}"
                ActiveAnalysisSelection="{Binding #Root.ActiveAnalysisSelection}"
                SuspensionType="{Binding #Root.SuspensionType}"
                Telemetry="{Binding #Root.Telemetry}" />

                <plots:AnalysisPlotView
                AnalysisRange="{Binding #Root.AnalysisRange}"
                Grid.Row="2"
                BalanceType="Rebound"
                ExtensionSlots="{Binding #Root.ExtensionSlots}"
                AnalysisPlotKind="StrokeLengthDistribution"
                SelectAnalysisRangeCommand="{Binding #Root.SelectAnalysisRangeCommand}"
                ActiveAnalysisSelection="{Binding #Root.ActiveAnalysisSelection}"
                SuspensionType="{Binding #Root.SuspensionType}"
                Telemetry="{Binding #Root.Telemetry}" />

                <plots:AnalysisPlotView
                AnalysisRange="{Binding #Root.AnalysisRange}"
                Grid.Row="3"
                BalanceType="Rebound"
                ExtensionSlots="{Binding #Root.ExtensionSlots}"
                AnalysisPlotKind="StrokeSpeedDistribution"
                SelectAnalysisRangeCommand="{Binding #Root.SelectAnalysisRangeCommand}"
                ActiveAnalysisSelection="{Binding #Root.ActiveAnalysisSelection}"
                SuspensionType="{Binding #Root.SuspensionType}"
                Telemetry="{Binding #Root.Telemetry}" />

                <plots:AnalysisPlotView
                AnalysisRange="{Binding #Root.AnalysisRange}"
                ExtensionSlots="{Binding #Root.ExtensionSlots}"
                Grid.Row="4"
                AnalysisPlotKind="DeepTravelDistribution"
                SelectAnalysisRangeCommand="{Binding #Root.SelectAnalysisRangeCommand}"
                ActiveAnalysisSelection="{Binding #Root.ActiveAnalysisSelection}"
                SuspensionType="{Binding #Root.SuspensionType}"
                Telemetry="{Binding #Root.Telemetry}" />
            </Grid>
        </controls:PlaceholderOverlayContainer.ReadyContent>
        <controls:PlaceholderOverlayContainer.PlaceholderContent>
            <controls:SurfacePlaceholderCard
            MinCardHeight="{Binding #Root.MinCardHeight}"
            Title="{Binding #Root.Title}" />
        </controls:PlaceholderOverlayContainer.PlaceholderContent>
    </controls:PlaceholderOverlayContainer>
</UserControl>
