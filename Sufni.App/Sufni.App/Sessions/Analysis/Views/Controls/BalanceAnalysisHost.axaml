<UserControl
x:Name="Root"
x:Class="Sufni.App.Sessions.Analysis.Views.Controls.BalanceAnalysisHost"
x:DataType="analysisControls:BalanceAnalysisHost"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:analysisControls="clr-namespace:Sufni.App.Sessions.Analysis.Views.Controls"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:plots="clr-namespace:Sufni.App.Sessions.Plots.Views.Plots"
xmlns:zoom="clr-namespace:Sufni.App.ExtensionHost.Runtime.Presentation;assembly=Sufni.App.ExtensionHost"
d:DesignHeight="450"
d:DesignWidth="800"
mc:Ignorable="d">

    <controls:PlaceholderOverlayContainer PresentationState="{Binding #Root.PresentationState}">
        <controls:PlaceholderOverlayContainer.ReadyContent>
            <Grid>
                <zoom:PlotZoomContainer
                Height="{Binding #Root.PlotHeight}"
                IsVisible="{Binding #Root.HasAnalysisData}">
                    <plots:AnalysisPlotView
                    Name="{Binding #Root.PlotName}"
                    AnalysisRange="{Binding #Root.AnalysisRange}"
                    BalanceDisplacementMode="{Binding #Root.BalanceDisplacementMode}"
                    BalanceSpeedMode="{Binding #Root.BalanceSpeedMode}"
                    BalanceType="{Binding #Root.BalanceType}"
                    DampingSpeedCutoffs="{Binding #Root.PlotDampingSpeedCutoffs}"
                    ExtensionSlots="{Binding #Root.ExtensionSlots}"
                    HeaderContent="{Binding #Root.HeaderContent}"
                    AnalysisPlotKind="Balance"
                    Telemetry="{Binding #Root.Telemetry}" />
                </zoom:PlotZoomContainer>

                <Svg
                Name="{Binding #Root.StaticSourceName}"
                IsVisible="{Binding !#Root.HasAnalysisData}"
                Source="{Binding #Root.StaticSource}" />
            </Grid>
        </controls:PlaceholderOverlayContainer.ReadyContent>
        <controls:PlaceholderOverlayContainer.PlaceholderContent>
            <controls:SurfacePlaceholderCard
            Margin="{Binding #Root.PlaceholderMargin}"
            MinCardHeight="{Binding #Root.MinCardHeight}"
            Title="{Binding #Root.Title}" />
        </controls:PlaceholderOverlayContainer.PlaceholderContent>
    </controls:PlaceholderOverlayContainer>
</UserControl>
