<UserControl
x:Class="Sufni.App.Sessions.Analysis.DesktopViews.Items.SessionAnalysisDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Sufni.App.Extensibility.Views"
xmlns:converters="clr-namespace:Sufni.App.Shared.Views.Converters"
xmlns:controls="clr-namespace:Sufni.App.Sessions.Analysis.Views.Controls"
xmlns:itemviews="clr-namespace:Sufni.App.Sessions.Insights.Views.Items"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:plots="clr-namespace:Sufni.App.Sessions.Plots.Views.Plots"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Detail.ViewModels.Editors"
d:DesignHeight="450"
d:DesignWidth="800"
x:DataType="vm:ISessionAnalysisWorkspace"
mc:Ignorable="d">

    <Grid RowDefinitions="auto *">
        <Grid.Resources>
            <converters:SurfaceStateToGridLengthConverter x:Key="SurfaceStateToGridLengthConverter" />
            <converters:AnySurfaceStateToGridLengthMultiConverter x:Key="AnySurfaceStateToGridLengthMultiConverter" />
        </Grid.Resources>

        <TabStrip Name="TabControl" Grid.Row="0">
            <TabStrip.Styles>
                <Style Selector="TabStripItem">
                    <Setter Property="Foreground" Value="{DynamicResource SufniTabText}" />
                </Style>
                <Style Selector="TabStripItem:selected">
                    <Setter Property="Background" Value="{DynamicResource SufniTabSurfaceSelected}" />
                </Style>
                <Style Selector="TabStripItem:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource SufniTabSurfaceHover}" />
                </Style>
                <Style Selector="TabStripItem:pointerover:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource SufniTabSurfaceSelected}" />
                </Style>
                <Style Selector="TabStripItem:selected /template/ Border#PART_SelectedPipe">
                    <Setter Property="Background" Value="{DynamicResource SufniAccentIndicatorTabUnderline}" />
                    <Setter Property="Height" Value="{StaticResource SufniSelectionIndicatorThickness}" />
                </Style>
            </TabStrip.Styles>

            <TabStrip.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid HorizontalAlignment="Stretch" Rows="1" />
                </ItemsPanelTemplate>
            </TabStrip.ItemsPanel>
        </TabStrip>

        <ScrollViewer
        Name="AnalysisPaneScrollViewer"
        Grid.Row="1"
        Margin="16,16,16,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
            <StackPanel
            Name="AnalysisScrollablePanel"
            Width="{Binding #AnalysisPaneScrollViewer.Bounds.Width}"
            ClipToBounds="True"
            Spacing="16">
                <views:RecordedSessionAnalysisContributionsView ExtensionSlots="{Binding ExtensionSlots}" />

                <ItemsControl Name="AnalysisContentHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Panel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.Items>

                <!--  Spring rate  -->
                <Grid Name="SpringRate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FrontAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                            <ColumnDefinition Width="{Binding RearAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        </Grid.ColumnDefinitions>

                        <controls:TravelAnalysisHost
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        AnalysisRange="{Binding AnalysisRange}"
                        ExtensionSlots="{Binding ExtensionSlots}"
                        PresentationState="{Binding FrontAnalysisState}"
                        ShowFrequencyDistribution="True"
                        SuspensionType="Front"
                        Telemetry="{Binding TelemetryData}"
                        Title="Front spring"
                        TravelDistributionMode="{Binding SelectedTravelDistributionMode}">
                            <controls:TravelAnalysisHost.HeaderContent>
                                <ComboBox
                                Name="FrontTravelDistributionModeComboBox"
                                Width="170"
                                IsVisible="{Binding !#AnalysisContentHost.DataContext.RearAnalysisState.ReservesLayout}"
                                ItemsSource="{Binding #AnalysisContentHost.DataContext.TravelDistributionModeOptions}"
                                SelectedValue="{Binding #AnalysisContentHost.DataContext.SelectedTravelDistributionMode, Mode=TwoWay}"
                                SelectedValueBinding="{Binding Value, DataType=vm:TravelDistributionModeOption}"
                                ToolTip.Tip="Choose whether spring stats show active stroke movement or overall ride height.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TravelDistributionModeOption">
                                            <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:TravelAnalysisHost.HeaderContent>
                        </controls:TravelAnalysisHost>

                        <controls:TravelAnalysisHost
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        AnalysisRange="{Binding AnalysisRange}"
                        ExtensionSlots="{Binding ExtensionSlots}"
                        PresentationState="{Binding RearAnalysisState}"
                        ShowFrequencyDistribution="True"
                        SuspensionType="Rear"
                        Telemetry="{Binding TelemetryData}"
                        Title="Rear spring"
                        TravelDistributionMode="{Binding SelectedTravelDistributionMode}">
                            <controls:TravelAnalysisHost.HeaderContent>
                                <ComboBox
                                Name="TravelDistributionModeComboBox"
                                Width="170"
                                IsVisible="{Binding #AnalysisContentHost.DataContext.RearAnalysisState.ReservesLayout}"
                                ItemsSource="{Binding #AnalysisContentHost.DataContext.TravelDistributionModeOptions}"
                                SelectedValue="{Binding #AnalysisContentHost.DataContext.SelectedTravelDistributionMode, Mode=TwoWay}"
                                SelectedValueBinding="{Binding Value, DataType=vm:TravelDistributionModeOption}"
                                ToolTip.Tip="Choose whether spring stats show active stroke movement or overall ride height.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TravelDistributionModeOption">
                                            <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:TravelAnalysisHost.HeaderContent>
                        </controls:TravelAnalysisHost>
                    </Grid>
                </Grid>

                <!--  Strokes  -->
                <Grid Name="Strokes">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FrontAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                            <ColumnDefinition Width="{Binding RearAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        </Grid.ColumnDefinitions>

                        <controls:StrokeAnalysisHost
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        AnalysisRange="{Binding AnalysisRange}"
                        ExtensionSlots="{Binding ExtensionSlots}"
                        PresentationState="{Binding FrontAnalysisState}"
                        SelectAnalysisRangeCommand="{Binding SelectAnalysisRangeCommand}"
                        ActiveFrontAnalysisSelection="{Binding ActiveFrontAnalysisSelection}"
                        ActiveRearAnalysisSelection="{Binding ActiveRearAnalysisSelection}"
                        SuspensionType="Front"
                        Telemetry="{Binding TelemetryData}"
                        Title="Front strokes" />

                        <controls:StrokeAnalysisHost
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        AnalysisRange="{Binding AnalysisRange}"
                        ExtensionSlots="{Binding ExtensionSlots}"
                        PresentationState="{Binding RearAnalysisState}"
                        SelectAnalysisRangeCommand="{Binding SelectAnalysisRangeCommand}"
                        ActiveFrontAnalysisSelection="{Binding ActiveFrontAnalysisSelection}"
                        ActiveRearAnalysisSelection="{Binding ActiveRearAnalysisSelection}"
                        SuspensionType="Rear"
                        Telemetry="{Binding TelemetryData}"
                        Title="Rear strokes" />
                    </Grid>
                </Grid>

                <!--  Damping  -->
                <Grid
                Name="Damping"
                RowDefinitions="Auto,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding FrontAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        <ColumnDefinition Width="{Binding FrontAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=Auto}" />
                        <ColumnDefinition Width="{Binding RearAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        <ColumnDefinition Width="{Binding RearAnalysisState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=Auto}" />
                    </Grid.ColumnDefinitions>

                    <plots:TravelPercentageLegend
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="38,0,218,8">
                        <plots:TravelPercentageLegend.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="FrontAnalysisState.ReservesLayout" />
                                <Binding Path="RearAnalysisState.ReservesLayout" />
                            </MultiBinding>
                        </plots:TravelPercentageLegend.IsVisible>
                    </plots:TravelPercentageLegend>

                    <ComboBox
                    Name="VelocityAverageModeComboBox"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    ZIndex="1"
                    Width="190"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    ItemsSource="{Binding VelocityAverageModeOptions}"
                    SelectedValue="{Binding SelectedVelocityAverageMode, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value, DataType=vm:VelocityAverageModeOption}"
                    ToolTip.Tip="Choose whether damping bars show time spent in bins or one peak event per stroke.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VelocityAverageModeOption">
                                <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <controls:DampingAnalysisHost
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    AnalysisRange="{Binding AnalysisRange}"
                    DampingSpeedCutoffs="{Binding DampingSpeedCutoffs}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    HscPercentage="{Binding DampingPercentages.FrontHscPercentage}"
                    HsrPercentage="{Binding DampingPercentages.FrontHsrPercentage}"
                    LscPercentage="{Binding DampingPercentages.FrontLscPercentage}"
                    LsrPercentage="{Binding DampingPercentages.FrontLsrPercentage}"
                    PlotHeight="440"
                    PlotDampingSpeedCutoffs="{Binding PlotDampingSpeedCutoffs}"
                    PresentationState="{Binding FrontAnalysisState}"
                    SelectAnalysisRangeCommand="{Binding SelectAnalysisRangeCommand}"
                    ActiveFrontAnalysisSelection="{Binding ActiveFrontAnalysisSelection}"
                    ActiveRearAnalysisSelection="{Binding ActiveRearAnalysisSelection}"
                    AnalysisWorkspace="{Binding}"
                    SuspensionType="Front"
                    Telemetry="{Binding TelemetryData}"
                    Title="Front damping"
                    VelocityAverageMode="{Binding SelectedVelocityAverageMode}" />

                    <controls:DampingAnalysisHost
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    AnalysisRange="{Binding AnalysisRange}"
                    DampingSpeedCutoffs="{Binding DampingSpeedCutoffs}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    HscPercentage="{Binding DampingPercentages.RearHscPercentage}"
                    HsrPercentage="{Binding DampingPercentages.RearHsrPercentage}"
                    LscPercentage="{Binding DampingPercentages.RearLscPercentage}"
                    LsrPercentage="{Binding DampingPercentages.RearLsrPercentage}"
                    PlotHeight="440"
                    PlotDampingSpeedCutoffs="{Binding PlotDampingSpeedCutoffs}"
                    PresentationState="{Binding RearAnalysisState}"
                    SelectAnalysisRangeCommand="{Binding SelectAnalysisRangeCommand}"
                    ActiveFrontAnalysisSelection="{Binding ActiveFrontAnalysisSelection}"
                    ActiveRearAnalysisSelection="{Binding ActiveRearAnalysisSelection}"
                    AnalysisWorkspace="{Binding}"
                    SuspensionType="Rear"
                    Telemetry="{Binding TelemetryData}"
                    Title="Rear damping"
                    VelocityAverageMode="{Binding SelectedVelocityAverageMode}" />
                </Grid>

                <!--  Balance plots  -->
                <Grid Name="Balance">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding CompressionBalanceState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        <ColumnDefinition Width="{Binding ReboundBalanceState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                    </Grid.ColumnDefinitions>

                    <controls:BalanceAnalysisHost
                    Grid.Column="0"
                    AnalysisRange="{Binding AnalysisRange}"
                    BalanceDisplacementMode="{Binding SelectedBalanceDisplacementMode}"
                    BalanceSpeedMode="{Binding SelectedBalanceSpeedMode}"
                    BalanceType="Compression"
                    DampingSpeedCutoffs="{Binding DampingSpeedCutoffs}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    PlotHeight="380"
                    PlotDampingSpeedCutoffs="{Binding PlotDampingSpeedCutoffs}"
                    PresentationState="{Binding CompressionBalanceState}"
                    Telemetry="{Binding TelemetryData}"
                    Title="Compression balance">
                        <controls:BalanceAnalysisHost.HeaderContent>
                            <StackPanel
                            IsVisible="{Binding !#AnalysisContentHost.DataContext.ReboundBalanceState.ReservesLayout}"
                            Orientation="Horizontal"
                            Spacing="8">
                                <ComboBox
                                Name="CompressionBalanceDisplacementModeComboBox"
                                Width="150"
                                ItemsSource="{Binding #AnalysisContentHost.DataContext.BalanceDisplacementModeOptions}"
                                SelectedValue="{Binding #AnalysisContentHost.DataContext.SelectedBalanceDisplacementMode, Mode=TwoWay}"
                                SelectedValueBinding="{Binding Value, DataType=vm:BalanceDisplacementModeOption}"
                                ToolTip.Tip="Zenith uses deepest stroke travel. Travel uses start-to-end stroke distance.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BalanceDisplacementModeOption">
                                            <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ComboBox
                                Name="CompressionBalanceSpeedModeComboBox"
                                Width="150"
                                ItemsSource="{Binding #AnalysisContentHost.DataContext.BalanceSpeedModeOptions}"
                                SelectedValue="{Binding #AnalysisContentHost.DataContext.SelectedBalanceSpeedMode, Mode=TwoWay}"
                                SelectedValueBinding="{Binding Value, DataType=vm:BalanceSpeedModeOption}"
                                ToolTip.Tip="Choose whether balance slopes use low-speed strokes, high-speed strokes, or both.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BalanceSpeedModeOption">
                                            <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </controls:BalanceAnalysisHost.HeaderContent>
                    </controls:BalanceAnalysisHost>

                    <controls:BalanceAnalysisHost
                    Grid.Column="1"
                    AnalysisRange="{Binding AnalysisRange}"
                    BalanceDisplacementMode="{Binding SelectedBalanceDisplacementMode}"
                    BalanceSpeedMode="{Binding SelectedBalanceSpeedMode}"
                    BalanceType="Rebound"
                    DampingSpeedCutoffs="{Binding DampingSpeedCutoffs}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    PlotHeight="380"
                    PlotDampingSpeedCutoffs="{Binding PlotDampingSpeedCutoffs}"
                    PresentationState="{Binding ReboundBalanceState}"
                    Telemetry="{Binding TelemetryData}"
                    Title="Rebound balance">
                        <controls:BalanceAnalysisHost.HeaderContent>
                            <StackPanel
                            IsVisible="{Binding #AnalysisContentHost.DataContext.ReboundBalanceState.ReservesLayout}"
                            Orientation="Horizontal"
                            Spacing="8">
                                <ComboBox
                                Name="BalanceDisplacementModeComboBox"
                                Width="150"
                                ItemsSource="{Binding #AnalysisContentHost.DataContext.BalanceDisplacementModeOptions}"
                                SelectedValue="{Binding #AnalysisContentHost.DataContext.SelectedBalanceDisplacementMode, Mode=TwoWay}"
                                SelectedValueBinding="{Binding Value, DataType=vm:BalanceDisplacementModeOption}"
                                ToolTip.Tip="Zenith uses deepest stroke travel. Travel uses start-to-end stroke distance.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BalanceDisplacementModeOption">
                                            <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ComboBox
                                Name="BalanceSpeedModeComboBox"
                                Width="150"
                                ItemsSource="{Binding #AnalysisContentHost.DataContext.BalanceSpeedModeOptions}"
                                SelectedValue="{Binding #AnalysisContentHost.DataContext.SelectedBalanceSpeedMode, Mode=TwoWay}"
                                SelectedValueBinding="{Binding Value, DataType=vm:BalanceSpeedModeOption}"
                                ToolTip.Tip="Choose whether balance slopes use low-speed strokes, high-speed strokes, or both.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BalanceSpeedModeOption">
                                            <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </controls:BalanceAnalysisHost.HeaderContent>
                    </controls:BalanceAnalysisHost>
                </Grid>

                <!--  Vibration  -->
                <Grid Name="Vibration">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding FrontForkVibrationState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        <ColumnDefinition Width="{Binding FrontFrameVibrationState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        <ColumnDefinition Width="{Binding RearForkVibrationState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                        <ColumnDefinition Width="{Binding RearFrameVibrationState, Converter={StaticResource SurfaceStateToGridLengthConverter}, ConverterParameter=*}" />
                    </Grid.ColumnDefinitions>

                    <controls:VibrationAnalysisHost
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    AnalysisRange="{Binding AnalysisRange}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    ImuLocation="Fork"
                    MinCardHeight="320"
                    PlotRowHeight="260"
                    PresentationState="{Binding FrontForkVibrationState}"
                    SuspensionType="Front"
                    Telemetry="{Binding TelemetryData}"
                    Title="Front fork" />

                    <controls:VibrationAnalysisHost
                    Grid.Column="1"
                    Margin="4,0,4,0"
                    AnalysisRange="{Binding AnalysisRange}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    ImuLocation="Frame"
                    MinCardHeight="320"
                    PlotRowHeight="260"
                    PresentationState="{Binding FrontFrameVibrationState}"
                    SuspensionType="Front"
                    Telemetry="{Binding TelemetryData}"
                    Title="Front frame" />

                    <controls:VibrationAnalysisHost
                    Grid.Column="2"
                    Margin="4,0,4,0"
                    AnalysisRange="{Binding AnalysisRange}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    ImuLocation="Fork"
                    MinCardHeight="320"
                    PlotRowHeight="260"
                    PresentationState="{Binding RearForkVibrationState}"
                    SuspensionType="Rear"
                    Telemetry="{Binding TelemetryData}"
                    Title="Rear fork" />

                    <controls:VibrationAnalysisHost
                    Grid.Column="3"
                    Margin="4,0,0,0"
                    AnalysisRange="{Binding AnalysisRange}"
                    ExtensionSlots="{Binding ExtensionSlots}"
                    ImuLocation="Frame"
                    MinCardHeight="320"
                    PlotRowHeight="260"
                    PresentationState="{Binding RearFrameVibrationState}"
                    SuspensionType="Rear"
                    Telemetry="{Binding TelemetryData}"
                    Title="Rear frame" />
                </Grid>

                <!--  Analysis  -->
                <Grid Name="Analysis">
                    <itemviews:SessionInsightsView />
                </Grid>
                    </ItemsControl.Items>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
