<UserControl
x:Class="Sufni.App.Sessions.Media.DesktopViews.Items.SessionMediaDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:desktopControls="clr-namespace:Sufni.App.Shared.DesktopViews.Controls"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:v="clr-namespace:Sufni.App.MapsAndTracks.Views"
xmlns:videoViews="clr-namespace:Sufni.App.Video.Views"
xmlns:videoVm="clr-namespace:Sufni.App.Video.ViewModels"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Detail.ViewModels.Editors"
d:DesignHeight="450"
d:DesignWidth="320"
x:Name="Root"
x:DataType="vm:ISessionMediaWorkspace"
mc:Ignorable="d">

    <Grid
        x:Name="MediaContentRoot"
        IsVisible="{Binding HasMediaContent}">

        <desktopControls:CollapsibleSplitView
            x:Name="MediaSplit"
            FirstPaneLabel="map"
            Orientation="Vertical"
            SecondPaneLabel="video">

            <desktopControls:CollapsibleSplitView.FirstContent>
                <controls:PlaceholderOverlayContainer
                    x:Name="MapHost"
                    IsVisible="{Binding MapState.ReservesLayout}"
                    PresentationState="{Binding MapState}">
                    <controls:PlaceholderOverlayContainer.ReadyContent>
                        <v:MapView
                            x:Name="MapViewControl"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    </controls:PlaceholderOverlayContainer.ReadyContent>
                    <controls:PlaceholderOverlayContainer.PlaceholderContent>
                        <controls:SurfacePlaceholderCard Title="Map" />
                    </controls:PlaceholderOverlayContainer.PlaceholderContent>
                </controls:PlaceholderOverlayContainer>
            </desktopControls:CollapsibleSplitView.FirstContent>

            <desktopControls:CollapsibleSplitView.SecondContent>
                <ContentControl x:Name="VideoHost" Content="{Binding Video}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="videoVm:VideoPaneViewModel">
                            <videoViews:VideoPaneView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </desktopControls:CollapsibleSplitView.SecondContent>
        </desktopControls:CollapsibleSplitView>
    </Grid>
</UserControl>
