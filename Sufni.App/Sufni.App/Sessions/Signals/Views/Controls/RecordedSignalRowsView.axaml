<UserControl
    xmlns:terrainViews="using:Sufni.App.Terrain.Views"
    xmlns:terrainPlots="using:Sufni.App.Terrain.Plots"
    xmlns:recordedImuPlots="using:Sufni.App.Sessions.Plots.Views.Plots"
    xmlns:sessionPreferences="using:Sufni.App.Sessions.Models"
    xmlns:sessionSignals="using:Sufni.App.Sessions.Signals.Views.Controls"
x:Name="Root"
x:Class="Sufni.App.Sessions.Signals.Views.Controls.RecordedSignalRowsView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:plots2="clr-namespace:Sufni.App.Sessions.Plots.Views.Plots"
    xmlns:overlays="clr-namespace:Sufni.App.Shared.Views.Overlays"
    xmlns:plots3="clr-namespace:Sufni.App.MapsAndTracks.Views.Plots"
xmlns:behaviors="clr-namespace:Sufni.App.Shell.Behaviors"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:models="clr-namespace:Sufni.App.Infrastructure"
xmlns:plotModels="clr-namespace:Sufni.App.MapsAndTracks.Plots"
xmlns:plots="clr-namespace:Sufni.App.LiveDaq.Views.Plots"
xmlns:segmentViews="clr-namespace:Sufni.App.Segments.Views"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Presentation"
d:DesignHeight="450"
d:DesignWidth="800"
behaviors:HapticFeedbackBehavior.IsEnabled="True"
x:DataType="vm:IRecordedSessionSignalsWorkspace"
mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="sessionSignals|SignalRow.sprungSource">
            <Setter Property="TitleForeground" Value="{DynamicResource SufniStatusWarningBrush}" />
        </Style>
    </UserControl.Styles>

    <sessionSignals:SignalRowsRoot x:Name="SignalRowsRoot" SignalLayoutPreferences="{Binding SignalLayoutPreferences, Mode=TwoWay}">
        <sessionSignals:SignalRowsRoot.Rows>
            <sessionSignals:SignalRow
            RowId="{x:Static sessionPreferences:SignalRowIds.Travel}"
            segmentViews:SegmentComparisonRows.Rows="{Binding SegmentComparison.TravelRows}"
            segmentViews:SegmentComparisonRows.Timeline="{Binding Timeline}"
            HeaderActions="{Binding TravelHeaderActions}"
            Title="Travel (mm)"
            PresentationState="{Binding TravelSignalState}">
                <sessionSignals:SignalRow.PlotContent>
                    <plots2:TravelPlotView
                    Name="Travel"
                    AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                    SignalsWorkspace="{Binding}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                    SignalRowId="{x:Static sessionPreferences:SignalRowIds.Travel}"
                    ShowAirtime="{Binding ShowAirtime}"
                    ShowAnalysisSelection="{Binding ShowAnalysisSelection}"
                    SourceVisibility="{Binding SourceVisibility}"
                    AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                    SmoothingLevel="{Binding SignalDisplayPreferences.TravelSmoothing}"
                    Telemetry="{Binding TelemetryData}"
                    Timeline="{Binding Timeline}" />
                </sessionSignals:SignalRow.PlotContent>
                <sessionSignals:SignalRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="Travel" />
                </sessionSignals:SignalRow.PlaceholderContent>
                <sessionSignals:SignalRow.ChildRows>
                    <sessionSignals:SignalRow
                    RowId="{x:Static sessionPreferences:SignalRowIds.Velocity}"
                    segmentViews:SegmentComparisonRows.Rows="{Binding SegmentComparison.VelocityRows}"
                    segmentViews:SegmentComparisonRows.Timeline="{Binding Timeline}"
                    HeaderActions="{Binding VelocityHeaderActions}"
                    Title="Velocity (m/s)"
                    PresentationState="{Binding VelocitySignalState}">
                        <sessionSignals:SignalRow.PlotContent>
                            <plots2:VelocityPlotView
                            Name="Velocity"
                            AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                            SignalsWorkspace="{Binding}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                            SignalRowId="{x:Static sessionPreferences:SignalRowIds.Velocity}"
                            ShowAirtime="{Binding ShowVelocityAirtime}"
                            ShowAnalysisSelection="{Binding ShowVelocityAnalysisSelection}"
                            SourceVisibility="{Binding SourceVisibility}"
                            AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                            SmoothingLevel="{Binding SignalDisplayPreferences.VelocitySmoothing}"
                            Telemetry="{Binding TelemetryData}"
                            Timeline="{Binding Timeline}" />
                        </sessionSignals:SignalRow.PlotContent>
                        <sessionSignals:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Velocity" />
                        </sessionSignals:SignalRow.PlaceholderContent>
                    </sessionSignals:SignalRow>
                </sessionSignals:SignalRow.ChildRows>
            </sessionSignals:SignalRow>

            <sessionSignals:SignalRow
            RowId="{x:Static sessionPreferences:SignalRowIds.Imu}"
            segmentViews:SegmentComparisonRows.Rows="{Binding SegmentComparison.ImuRows}"
            segmentViews:SegmentComparisonRows.Timeline="{Binding Timeline}"
            HeaderActions="{Binding ImuHeaderActions}"
            Title="Vibration RMS (g)"
            TitleToolTip="Root-mean-square frame vibration — higher means rougher terrain or more chatter."
            PresentationState="{Binding ImuSignalState}">
                <sessionSignals:SignalRow.PlotContent>
                    <recordedImuPlots:ImuPlotView
                    Name="Imu"
                    AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                    AnalysisResultState="{Binding AnalysisResultState}"
                    SignalsWorkspace="{Binding}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                    SignalRowId="{x:Static sessionPreferences:SignalRowIds.Imu}"
                    ShowAirtime="{Binding ShowImuAirtime}"
                    ShowAnalysisSelection="{Binding ShowImuAnalysisSelection}"
                    SourceVisibility="{Binding SourceVisibility}"
                    AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                    SmoothingLevel="{Binding SignalDisplayPreferences.ImuSmoothing}"
                    Telemetry="{Binding TelemetryData}"
                    Timeline="{Binding Timeline}" />
                </sessionSignals:SignalRow.PlotContent>
                <sessionSignals:SignalRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="IMU" />
                </sessionSignals:SignalRow.PlaceholderContent>
                <sessionSignals:SignalRow.ChildRows>
                    <sessionSignals:SignalRow
                    RowId="{x:Static sessionPreferences:SignalRowIds.PitchRoll}"
                    HeaderActions="{Binding PitchRollHeaderActions}"
                    Title="Frame pitch/roll (deg)"
                    TitleToolTip="Frame tilt from the IMU — pitch is nose up/down, roll is lean side to side."
                    PresentationState="{Binding PitchRollSignalState}">
                        <sessionSignals:SignalRow.PlotContent>
                            <recordedImuPlots:FramePitchRollPlotView
                            Name="PitchRoll"
                            AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                            AnalysisResultState="{Binding AnalysisResultState}"
                            SignalsWorkspace="{Binding}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                            SignalRowId="{x:Static sessionPreferences:SignalRowIds.PitchRoll}"
                            ShowAirtime="{Binding ShowPitchRollAirtime}"
                            ShowAnalysisSelection="{Binding ShowPitchRollAnalysisSelection}"
                            AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                            SmoothingLevel="{Binding SignalDisplayPreferences.PitchRollSmoothing}"
                            Telemetry="{Binding TelemetryData}"
                            Timeline="{Binding Timeline}" />
                        </sessionSignals:SignalRow.PlotContent>
                        <sessionSignals:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Pitch/roll" />
                        </sessionSignals:SignalRow.PlaceholderContent>
                    </sessionSignals:SignalRow>
                </sessionSignals:SignalRow.ChildRows>
            </sessionSignals:SignalRow>

            <sessionSignals:SignalRow
            RowId="{x:Static sessionPreferences:SignalRowIds.Speed}"
            segmentViews:SegmentComparisonRows.Rows="{Binding SegmentComparison.SpeedRows}"
            segmentViews:SegmentComparisonRows.Timeline="{Binding Timeline}"
            HeaderActions="{Binding SpeedHeaderActions}"
            Title="GPS speed (km/h)"
            PresentationState="{Binding SpeedSignalState}">
                <sessionSignals:SignalRow.PlotContent>
                    <plots3:TrackSignalPlotView
                    Name="Speed"
                    AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                    SignalsWorkspace="{Binding}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    SignalRowId="{x:Static sessionPreferences:SignalRowIds.Speed}"
                    SignalKind="{x:Static plotModels:TrackSignalKind.Speed}"
                    ShowAirtime="{Binding ShowSpeedAirtime}"
                    ShowAnalysisSelection="{Binding ShowSpeedAnalysisSelection}"
                    AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                    SmoothingLevel="{Binding SignalDisplayPreferences.SpeedSmoothing}"
                    Telemetry="{Binding TelemetryData}"
                    Timeline="{Binding Timeline}"
                    TimelineContext="{Binding TrackTimelineContext}"
                    TrackPoints="{Binding TrackPoints}" />
                </sessionSignals:SignalRow.PlotContent>
                <sessionSignals:SignalRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="Speed" />
                </sessionSignals:SignalRow.PlaceholderContent>
                <sessionSignals:SignalRow.ChildRows>
                    <sessionSignals:SignalRow
                    RowId="{x:Static sessionPreferences:SignalRowIds.Elevation}"
                    HeaderActions="{Binding ElevationHeaderActions}"
                    Title="Elevation (m)"
                    PresentationState="{Binding ElevationSignalState}">
                        <sessionSignals:SignalRow.PlotContent>
                            <plots3:TrackSignalPlotView
                            Name="Elevation"
                            AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                            SignalsWorkspace="{Binding}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            SignalRowId="{x:Static sessionPreferences:SignalRowIds.Elevation}"
                            SignalKind="{x:Static plotModels:TrackSignalKind.Elevation}"
                            ShowAirtime="{Binding ShowElevationAirtime}"
                            ShowAnalysisSelection="{Binding ShowElevationAnalysisSelection}"
                            AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                            SmoothingLevel="{Binding SignalDisplayPreferences.ElevationSmoothing}"
                            Telemetry="{Binding TelemetryData}"
                            Timeline="{Binding Timeline}"
                            TimelineContext="{Binding TrackTimelineContext}"
                            TrackPoints="{Binding TrackPoints}" />
                        </sessionSignals:SignalRow.PlotContent>
                        <sessionSignals:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Elevation" />
                        </sessionSignals:SignalRow.PlaceholderContent>
                    </sessionSignals:SignalRow>
                </sessionSignals:SignalRow.ChildRows>
            </sessionSignals:SignalRow>
            <sessionSignals:SignalRow RowId="{x:Static sessionPreferences:SignalRowIds.Terrain}"
                Title="{Binding TerrainTitle}" Classes.sprungSource="{Binding TerrainSourceIsSprung}"
                FixedPlotHeight="{Binding #Root.TerrainPlotHeight}" TitleToolTip="{Binding TerrainSourceDescription}"
                HeaderActions="{Binding TerrainHeaderActions}" PresentationState="{Binding TerrainSignalState}">
                <sessionSignals:SignalRow.HeaderAccessory>
                    <terrainViews:TerrainScopeChipView DataContext="{Binding TerrainScope}" ShowLegends="{Binding #Root.CompactTerrainRow}" />
                </sessionSignals:SignalRow.HeaderAccessory>
                <sessionSignals:SignalRow.PlotContent>
                    <Grid RowDefinitions="*,Auto,Auto">
                        <terrainViews:TerrainClassStripPlotView
                            SignalRowId="{x:Static sessionPreferences:SignalRowIds.Terrain}"
                            Terrain="{Binding TerrainPresentation}" Telemetry="{Binding TelemetryData}"
                            Timeline="{Binding Timeline}" SignalsWorkspace="{Binding}" AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                            HideRightAxis="{Binding #Root.HideRightAxis}" ShowAirtime="{Binding ShowTerrainAirtime}"
                            ShowAnalysisSelection="{Binding ShowTerrainAnalysisSelection}"
                            AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}" />
                        <terrainViews:TerrainLegendView Grid.Row="1" Options="{Binding TerrainScope.Grade}" Margin="40,2,8,0"
                            IsVisible="{Binding !#Root.CompactTerrainRow}" />
                        <terrainViews:TerrainLegendView Grid.Row="2" Options="{Binding TerrainScope.Roughness}" Margin="40,2,8,2"
                            IsVisible="{Binding !#Root.CompactTerrainRow}" />
                    </Grid>
                </sessionSignals:SignalRow.PlotContent>
                <sessionSignals:SignalRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="Terrain" />
                </sessionSignals:SignalRow.PlaceholderContent>
                <sessionSignals:SignalRow.ChildRows>
                    <sessionSignals:SignalRow RowId="{x:Static sessionPreferences:SignalRowIds.Roughness}"
                        Title="Roughness (g at 7 m/s)"
                        segmentViews:SegmentComparisonRows.Rows="{Binding SegmentComparison.RoughnessRows}"
                        segmentViews:SegmentComparisonRows.Timeline="{Binding Timeline}"
                        HeaderActions="{Binding RoughnessHeaderActions}" PresentationState="{Binding RoughnessSignalState}">
                        <sessionSignals:SignalRow.PlotContent>
                            <terrainViews:TerrainSignalPlotView SignalKind="{x:Static terrainPlots:TerrainSignalKind.Roughness}"
                                SignalRowId="{x:Static sessionPreferences:SignalRowIds.Roughness}"
                                Terrain="{Binding TerrainPresentation}" Telemetry="{Binding TelemetryData}"
                                Timeline="{Binding Timeline}" SignalsWorkspace="{Binding}" AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                                HideRightAxis="{Binding #Root.HideRightAxis}" ShowAirtime="{Binding ShowRoughnessAirtime}"
                                ShowAnalysisSelection="{Binding ShowRoughnessAnalysisSelection}"
                                AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}" />
                        </sessionSignals:SignalRow.PlotContent>
                        <sessionSignals:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Roughness" />
                        </sessionSignals:SignalRow.PlaceholderContent>
                    </sessionSignals:SignalRow>
                    <sessionSignals:SignalRow RowId="{x:Static sessionPreferences:SignalRowIds.Grade}"
                        Title="Grade (° downhill)"
                        segmentViews:SegmentComparisonRows.Rows="{Binding SegmentComparison.GradeRows}"
                        segmentViews:SegmentComparisonRows.Timeline="{Binding Timeline}"
                        HeaderActions="{Binding GradeHeaderActions}" PresentationState="{Binding GradeSignalState}">
                        <sessionSignals:SignalRow.PlotContent>
                            <terrainViews:TerrainSignalPlotView SignalKind="{x:Static terrainPlots:TerrainSignalKind.Grade}"
                                SignalRowId="{x:Static sessionPreferences:SignalRowIds.Grade}"
                                Terrain="{Binding TerrainPresentation}" Telemetry="{Binding TelemetryData}"
                                Timeline="{Binding Timeline}" SignalsWorkspace="{Binding}" AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                                HideRightAxis="{Binding #Root.HideRightAxis}" ShowAirtime="{Binding ShowGradeAirtime}"
                                ShowAnalysisSelection="{Binding ShowGradeAnalysisSelection}"
                                AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}" />
                        </sessionSignals:SignalRow.PlotContent>
                        <sessionSignals:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Grade" />
                        </sessionSignals:SignalRow.PlaceholderContent>
                    </sessionSignals:SignalRow>
                    <sessionSignals:SignalRow RowId="{x:Static sessionPreferences:SignalRowIds.PedalBob}"
                        Title="Pedal bob (mm)" TitleToolTip="Rear travel bob at the pedal rhythm. Drawn only where pedalling is detected."
                        HeaderActions="{Binding PedalBobHeaderActions}" PresentationState="{Binding PedalBobSignalState}">
                        <sessionSignals:SignalRow.PlotContent>
                            <terrainViews:TerrainSignalPlotView SignalKind="{x:Static terrainPlots:TerrainSignalKind.PedalBob}"
                                SignalRowId="{x:Static sessionPreferences:SignalRowIds.PedalBob}"
                                Terrain="{Binding TerrainPresentation}" Telemetry="{Binding TelemetryData}"
                                Timeline="{Binding Timeline}" SignalsWorkspace="{Binding}" AnalysisRange="{Binding AnalysisRange}" TerrainSelection="{Binding TerrainScope.Selection}"
                                HideRightAxis="{Binding #Root.HideRightAxis}" ShowAirtime="{Binding ShowPedalBobAirtime}"
                                ShowAnalysisSelection="{Binding ShowPedalBobAnalysisSelection}"
                                AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}" />
                        </sessionSignals:SignalRow.PlotContent>
                        <sessionSignals:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Pedal bob" />
                        </sessionSignals:SignalRow.PlaceholderContent>
                    </sessionSignals:SignalRow>
                </sessionSignals:SignalRow.ChildRows>
            </sessionSignals:SignalRow>
        </sessionSignals:SignalRowsRoot.Rows>
    </sessionSignals:SignalRowsRoot>
</UserControl>
