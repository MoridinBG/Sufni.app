<UserControl
x:Name="Root"
x:Class="Sufni.App.Sessions.Signals.Views.Controls.RecordedSignalRowsView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:plots2="clr-namespace:Sufni.App.Sessions.Plots.Views.Plots"
    xmlns:overlays="clr-namespace:Sufni.App.Shared.Views.Overlays"
    xmlns:plots3="clr-namespace:Sufni.App.MapsAndTracks.Views.Plots"
xmlns:behaviors="clr-namespace:Sufni.App.Shell.Behaviors"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:models="clr-namespace:Sufni.App.Infrastructure"
xmlns:plotModels="clr-namespace:Sufni.App.MapsAndTracks.Plots"
xmlns:plots="clr-namespace:Sufni.App.LiveDaq.Views.Plots"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Detail.ViewModels.Editors"
d:DesignHeight="450"
d:DesignWidth="800"
behaviors:HapticFeedbackBehavior.IsEnabled="True"
x:DataType="vm:IRecordedSessionSignalsWorkspace"
mc:Ignorable="d">

    <controls:SignalRowsRoot x:Name="SignalRowsRoot" SignalLayoutPreferences="{Binding SignalLayoutPreferences, Mode=TwoWay}">
        <controls:SignalRowsRoot.Rows>
            <controls:SignalRow
            RowId="{x:Static models:SignalRowIds.Travel}"
            controls:SignalRowExtensionHost.ExtensionSlots="{Binding ExtensionSlots}"
            HeaderActions="{Binding TravelHeaderActions}"
            Title="Travel (mm)"
            PresentationState="{Binding TravelSignalState}">
                <controls:SignalRow.PlotContent>
                    <plots2:TravelPlotView
                    Name="Travel"
                    AnalysisRange="{Binding AnalysisRange}"
                    SignalsWorkspace="{Binding}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                    SignalRowId="{x:Static models:SignalRowIds.Travel}"
                    ShowAirtime="{Binding ShowAirtime}"
                    ShowAnalysisSelection="{Binding ShowAnalysisSelection}"
                    SourceVisibility="{Binding SourceVisibility}"
                    AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                    SmoothingLevel="{Binding SignalDisplayPreferences.TravelSmoothing}"
                    Telemetry="{Binding TelemetryData}"
                    Timeline="{Binding Timeline}" />
                </controls:SignalRow.PlotContent>
                <controls:SignalRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="Travel" />
                </controls:SignalRow.PlaceholderContent>
                <controls:SignalRow.ChildRows>
                    <controls:SignalRow
                    RowId="{x:Static models:SignalRowIds.Velocity}"
                    controls:SignalRowExtensionHost.ExtensionSlots="{Binding ExtensionSlots}"
                    HeaderActions="{Binding VelocityHeaderActions}"
                    Title="Velocity (m/s)"
                    PresentationState="{Binding VelocitySignalState}">
                        <controls:SignalRow.PlotContent>
                            <plots2:VelocityPlotView
                            Name="Velocity"
                            AnalysisRange="{Binding AnalysisRange}"
                            SignalsWorkspace="{Binding}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                            SignalRowId="{x:Static models:SignalRowIds.Velocity}"
                            ShowAirtime="{Binding ShowVelocityAirtime}"
                            ShowAnalysisSelection="{Binding ShowVelocityAnalysisSelection}"
                            SourceVisibility="{Binding SourceVisibility}"
                            AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                            SmoothingLevel="{Binding SignalDisplayPreferences.VelocitySmoothing}"
                            Telemetry="{Binding TelemetryData}"
                            Timeline="{Binding Timeline}" />
                        </controls:SignalRow.PlotContent>
                        <controls:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Velocity" />
                        </controls:SignalRow.PlaceholderContent>
                    </controls:SignalRow>
                </controls:SignalRow.ChildRows>
            </controls:SignalRow>

            <controls:SignalRow
            RowId="{x:Static models:SignalRowIds.Imu}"
            controls:SignalRowExtensionHost.ExtensionSlots="{Binding ExtensionSlots}"
            HeaderActions="{Binding ImuHeaderActions}"
            Title="Vibration RMS (g)"
            TitleToolTip="Root-mean-square frame vibration — higher means rougher terrain or more chatter."
            PresentationState="{Binding ImuSignalState}">
                <controls:SignalRow.PlotContent>
                    <plots:ImuPlotView
                    Name="Imu"
                    AnalysisRange="{Binding AnalysisRange}"
                    AnalysisResultState="{Binding AnalysisResultState}"
                    SignalsWorkspace="{Binding}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                    SignalRowId="{x:Static models:SignalRowIds.Imu}"
                    ShowAirtime="{Binding ShowImuAirtime}"
                    ShowAnalysisSelection="{Binding ShowImuAnalysisSelection}"
                    SourceVisibility="{Binding SourceVisibility}"
                    AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                    SmoothingLevel="{Binding SignalDisplayPreferences.ImuSmoothing}"
                    Telemetry="{Binding TelemetryData}"
                    Timeline="{Binding Timeline}" />
                </controls:SignalRow.PlotContent>
                <controls:SignalRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="IMU" />
                </controls:SignalRow.PlaceholderContent>
                <controls:SignalRow.ChildRows>
                    <controls:SignalRow
                    RowId="{x:Static models:SignalRowIds.PitchRoll}"
                    controls:SignalRowExtensionHost.ExtensionSlots="{Binding ExtensionSlots}"
                    HeaderActions="{Binding PitchRollHeaderActions}"
                    Title="Frame pitch/roll (deg)"
                    TitleToolTip="Frame tilt from the IMU — pitch is nose up/down, roll is lean side to side."
                    PresentationState="{Binding PitchRollSignalState}">
                        <controls:SignalRow.PlotContent>
                            <plots:FramePitchRollPlotView
                            Name="PitchRoll"
                            AnalysisRange="{Binding AnalysisRange}"
                            AnalysisResultState="{Binding AnalysisResultState}"
                            SignalsWorkspace="{Binding}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            MaximumDisplayHz="{Binding #Root.MaximumDisplayHz}"
                            SignalRowId="{x:Static models:SignalRowIds.PitchRoll}"
                            ShowAirtime="{Binding ShowPitchRollAirtime}"
                            ShowAnalysisSelection="{Binding ShowPitchRollAnalysisSelection}"
                            AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                            SmoothingLevel="{Binding SignalDisplayPreferences.PitchRollSmoothing}"
                            Telemetry="{Binding TelemetryData}"
                            Timeline="{Binding Timeline}" />
                        </controls:SignalRow.PlotContent>
                        <controls:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Pitch/roll" />
                        </controls:SignalRow.PlaceholderContent>
                    </controls:SignalRow>
                </controls:SignalRow.ChildRows>
            </controls:SignalRow>

            <controls:SignalRow
            RowId="{x:Static models:SignalRowIds.Speed}"
            controls:SignalRowExtensionHost.ExtensionSlots="{Binding ExtensionSlots}"
            HeaderActions="{Binding SpeedHeaderActions}"
            Title="GPS speed (km/h)"
            PresentationState="{Binding SpeedSignalState}">
                <controls:SignalRow.PlotContent>
                    <plots3:TrackSignalPlotView
                    Name="Speed"
                    AnalysisRange="{Binding AnalysisRange}"
                    SignalsWorkspace="{Binding}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    SignalRowId="{x:Static models:SignalRowIds.Speed}"
                    SignalKind="{x:Static plotModels:TrackSignalKind.Speed}"
                    ShowAirtime="{Binding ShowSpeedAirtime}"
                    ShowAnalysisSelection="{Binding ShowSpeedAnalysisSelection}"
                    AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                    SmoothingLevel="{Binding SignalDisplayPreferences.SpeedSmoothing}"
                    Telemetry="{Binding TelemetryData}"
                    Timeline="{Binding Timeline}"
                    TimelineContext="{Binding TrackTimelineContext}"
                    TrackPoints="{Binding TrackPoints}" />
                </controls:SignalRow.PlotContent>
                <controls:SignalRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="Speed" />
                </controls:SignalRow.PlaceholderContent>
                <controls:SignalRow.ChildRows>
                    <controls:SignalRow
                    RowId="{x:Static models:SignalRowIds.Elevation}"
                    controls:SignalRowExtensionHost.ExtensionSlots="{Binding ExtensionSlots}"
                    HeaderActions="{Binding ElevationHeaderActions}"
                    Title="Elevation (m)"
                    PresentationState="{Binding ElevationSignalState}">
                        <controls:SignalRow.PlotContent>
                            <plots3:TrackSignalPlotView
                            Name="Elevation"
                            AnalysisRange="{Binding AnalysisRange}"
                            SignalsWorkspace="{Binding}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            SignalRowId="{x:Static models:SignalRowIds.Elevation}"
                            SignalKind="{x:Static plotModels:TrackSignalKind.Elevation}"
                            ShowAirtime="{Binding ShowElevationAirtime}"
                            ShowAnalysisSelection="{Binding ShowElevationAnalysisSelection}"
                            AnalysisSelectionHighlightRanges="{Binding AnalysisSelectionHighlightRanges}"
                            SmoothingLevel="{Binding SignalDisplayPreferences.ElevationSmoothing}"
                            Telemetry="{Binding TelemetryData}"
                            Timeline="{Binding Timeline}"
                            TimelineContext="{Binding TrackTimelineContext}"
                            TrackPoints="{Binding TrackPoints}" />
                        </controls:SignalRow.PlotContent>
                        <controls:SignalRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Elevation" />
                        </controls:SignalRow.PlaceholderContent>
                    </controls:SignalRow>
                </controls:SignalRow.ChildRows>
            </controls:SignalRow>
        </controls:SignalRowsRoot.Rows>
    </controls:SignalRowsRoot>
</UserControl>
