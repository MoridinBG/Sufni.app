<UserControl
x:Class="Sufni.App.Sessions.Signals.Views.SessionPages.RecordedSignalsPageView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Sufni.App.Extensibility.Views"
    xmlns:controls2="clr-namespace:Sufni.App.Sessions.Media.Views.Controls"
    xmlns:controls3="clr-namespace:Sufni.App.Sessions.Signals.Views.Controls"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:plots="clr-namespace:Sufni.App.Shared.Plots"
xmlns:v="clr-namespace:Sufni.App.MapsAndTracks.Views"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Signals.ViewModels.SessionPages"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:RecordedSignalsPageViewModel"
mc:Ignorable="d">

    <ScrollViewer
    x:Name="PageScrollViewer"
    Width="{Binding $parent[ScrollViewer].Bounds.Width}"
    IsScrollChainingEnabled="False">
        <StackPanel Spacing="10">
            <views:RecordedSessionToolbarContributionsView ExtensionSlots="{Binding Workspace.ExtensionSlots}" />

            <Grid MinHeight="{Binding #PageScrollViewer.Bounds.Height}">
                <controls3:RecordedSignalRowsView
                Margin="-8,0,-8,0"
                DataContext="{Binding Workspace}"
                HideRightAxis="True"
                MaximumDisplayHz="{x:Static plots:PlotSettings.RecordedMobileMaximumDisplayHz}" />

                <controls:SurfacePlaceholderCard
                Name="NoSignalsDataPlaceholder"
                MinCardHeight="280"
                Title="No signals data for this session.">
                    <controls:SurfacePlaceholderCard.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!Workspace.TravelSignalState.ReservesLayout" />
                            <Binding Path="!Workspace.VelocitySignalState.ReservesLayout" />
                            <Binding Path="!Workspace.ImuSignalState.ReservesLayout" />
                            <Binding Path="!Workspace.PitchRollSignalState.ReservesLayout" />
                            <Binding Path="!Workspace.SpeedSignalState.ReservesLayout" />
                            <Binding Path="!Workspace.ElevationSignalState.ReservesLayout" />
                        </MultiBinding>
                    </controls:SurfacePlaceholderCard.IsVisible>
                </controls:SurfacePlaceholderCard>
            </Grid>

            <controls:PlaceholderOverlayContainer
            Name="MapHost"
            Height="320"
            IsVisible="{Binding MediaWorkspace.MapState.ReservesLayout}"
            PresentationState="{Binding MediaWorkspace.MapState}">
                <controls:PlaceholderOverlayContainer.ReadyContent>
                    <v:MapView
                    Name="MobileMapView"
                    DataContext="{Binding MediaWorkspace.MapViewModel}"
                    ExtensionSlots="{Binding $parent[controls:PlaceholderOverlayContainer].DataContext.MediaWorkspace.ExtensionSlots}"
                    Timeline="{Binding $parent[controls:PlaceholderOverlayContainer].DataContext.MediaWorkspace.Timeline}" />
                </controls:PlaceholderOverlayContainer.ReadyContent>
                <controls:PlaceholderOverlayContainer.PlaceholderContent>
                    <controls:SurfacePlaceholderCard Title="Map" />
                </controls:PlaceholderOverlayContainer.PlaceholderContent>
            </controls:PlaceholderOverlayContainer>

            <controls2:RecordedSessionMediaPanesView ExtensionSlots="{Binding MediaWorkspace.ExtensionSlots}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
