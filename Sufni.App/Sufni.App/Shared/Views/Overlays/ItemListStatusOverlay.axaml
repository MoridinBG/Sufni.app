<UserControl
    x:Name="Root"
    x:Class="Sufni.App.Shared.Views.Overlays.ItemListStatusOverlay"
    ZIndex="10"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="120"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <Grid RowDefinitions="* auto auto">
        <controls:NotificationsBar
            Grid.Row="1"
            Margin="5,0"
            ZIndex="10" />

        <controls:ErrorMessagesBar
            Grid.Row="2"
            Margin="5,0"
            ZIndex="10" />

        <controls:UndoDeleteButton
            Grid.Row="0"
            Grid.RowSpan="3"
            IsVisible="{Binding #Root.ShowUndoDeleteButton}" />
    </Grid>
</UserControl>
