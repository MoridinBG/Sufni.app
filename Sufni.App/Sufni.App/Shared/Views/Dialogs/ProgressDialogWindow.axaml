<Window
x:Class="Sufni.App.Shared.Views.Dialogs.ProgressDialogWindow"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
Width="360"
Height="140"
CanResize="False"
ShowInTaskbar="False"
WindowStartupLocation="CenterOwner"
d:DesignHeight="140"
d:DesignWidth="360"
mc:Ignorable="d">
    <Border Padding="20" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Spacing="12">
            <TextBlock
            Name="TitleText"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />
            <ProgressBar
            Name="Progress"
            Maximum="1"
            Minimum="0" />
            <TextBlock
            Name="StatusText"
            TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
