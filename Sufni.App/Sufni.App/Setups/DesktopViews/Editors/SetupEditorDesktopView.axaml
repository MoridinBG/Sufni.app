<UserControl
x:Class="Sufni.App.Setups.DesktopViews.Editors.SetupEditorDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:shared="clr-namespace:Sufni.App.Setups.Views.Shared"
xmlns:v="clr-namespace:Sufni.App.Shared.Views.Controls"
xmlns:vm="clr-namespace:Sufni.App.Setups.ViewModels.Editors"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:SetupEditorViewModel"
Background="{DynamicResource SufniRegion}"
Focusable="True"
mc:Ignorable="d">

    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Loaded">
            <InvokeCommandAction Command="{Binding LoadedCommand}" />
        </EventTriggerBehavior>
        <EventTriggerBehavior EventName="Unloaded">
            <InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <Grid
    MinWidth="300"
    Margin="20,0,20,10"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    ColumnDefinitions="auto *"
    RowDefinitions="auto auto * auto 40 40 39">
        <!--  Name  -->
        <Label
        Grid.Row="0"
        Grid.Column="0"
        VerticalAlignment="Center"
        Content="Name: " />
        <TextBox
        Name="NameTextBox"
        Grid.Row="0"
        Grid.Column="1"
        Margin="2"
        HorizontalAlignment="Stretch"
        Text="{Binding Name}" />

        <shared:SetupEditorCommonFields
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        ShowBikeEditButton="True" />

        <!--  Error messages for Setup instance  -->
        <v:ErrorMessagesBar
        Grid.Row="3"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Margin="0,5,0,0" />

        <!--  Import  -->
        <Button
        Name="ImportButton"
        Grid.Row="4"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Margin="0,0,0,5"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Command="{Binding ImportCommand}"
        Content="Import from JSON" />

        <!--  Export  -->
        <Button
        Name="ExportButton"
        Grid.Row="5"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Margin="0,0,0,5"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Command="{Binding ExportCommand}"
        Content="Export as JSON" />

        <!--  Save and Reset buttons  -->
        <Grid
        Grid.Row="6"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        ColumnDefinitions="* auto">
            <Button
            Name="SaveButton"
            Grid.Column="0"
            Margin="0,0,10,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Command="{Binding SaveCommand}"
            Content="Save" />

            <Button
            Name="ResetButton"
            Grid.Column="1"
            Width="39"
            Height="39"
            Margin="0,0,5,0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Command="{Binding ResetCommand}">
                <Image
                Width="16"
                Height="16"
                Source="{SvgImage /Assets/fa-rotate-left.svg}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
