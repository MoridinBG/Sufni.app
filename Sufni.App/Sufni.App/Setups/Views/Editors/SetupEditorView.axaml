<UserControl
x:Class="Sufni.App.Setups.Views.Editors.SetupEditorView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:shared="clr-namespace:Sufni.App.Setups.Views.Shared"
xmlns:v="clr-namespace:Sufni.App.Shared.Views.Controls"
xmlns:vm="clr-namespace:Sufni.App.Setups.ViewModels.Editors"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:SetupEditorViewModel"
Background="{DynamicResource SufniRegion}"
Focusable="True"
mc:Ignorable="d">

    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Loaded">
            <InvokeCommandAction Command="{Binding LoadedCommand}" />
        </EventTriggerBehavior>
        <EventTriggerBehavior EventName="Unloaded">
            <InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <Grid
    MinWidth="300"
    Margin="20,10,20,10"
    HorizontalAlignment="Stretch"
    ColumnDefinitions="auto *"
    RowDefinitions="auto auto * auto auto auto auto">

        <!--  Name  -->
        <v:EditableTitle
        Grid.Row="0"
        Grid.ColumnSpan="2"
        Margin="0,0,0,10"
        HorizontalAlignment="Stretch" />

        <shared:SetupEditorCommonFields
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2" />

        <!--  Error messages for Setup instance  -->
        <v:ErrorMessagesBar
        Grid.Row="3"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Margin="0,5,0,0" />

        <!--  Import  -->
        <Button
        Name="ImportButton"
        Grid.Row="4"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        MinHeight="39"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Command="{Binding ImportCommand}"
        Content="import from file ..." />

        <!--  Export  -->
        <Button
        Name="ExportButton"
        Grid.Row="5"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Margin="0,5,0,0"
        MinHeight="39"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Command="{Binding ExportCommand}"
        Content="export to file ..." />

        <!--  Back, Save, Reset and Delete buttons  -->
        <v:CommonButtonLine
        Grid.Row="6"
        Grid.Column="0"
        Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
