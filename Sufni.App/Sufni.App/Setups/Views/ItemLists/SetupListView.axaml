<UserControl
    x:Class="Sufni.App.Setups.Views.ItemLists.SetupListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Sufni.App.Shell.Behaviors"
    xmlns:controls="clr-namespace:Sufni.App.Shell.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Sufni.App.Shared.Views.Overlays"
    xmlns:vml="clr-namespace:Sufni.App.Setups.ViewModels.ItemLists"
    d:DesignHeight="400"
    d:DesignWidth="500"
    x:DataType="vml:SetupListViewModel"
    Background="{DynamicResource SufniRegion}"
    behaviors:HapticFeedbackBehavior.IsEnabled="True"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="*" RowDefinitions="* auto auto">

        <!--  List of Setups  -->
        <controls:PullableMenuScrollViewer
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,15,0,5"
            Items="{Binding Items}"
            MenuItems="{Binding MenuItems}" />

        <shared:ItemListStatusOverlay
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0" />
    </Grid>
</UserControl>
