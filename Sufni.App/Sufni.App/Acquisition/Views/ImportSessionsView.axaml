<UserControl
x:Class="Sufni.App.Acquisition.Views.ImportSessionsView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:shared="clr-namespace:Sufni.App.Acquisition.Views.Shared"
xmlns:views="clr-namespace:Sufni.App.Acquisition.Views"
xmlns:vm="clr-namespace:Sufni.App.Acquisition.ViewModels"
xmlns:lifecycle="clr-namespace:Sufni.App.Shared.Views"
d:DesignHeight="600"
d:DesignWidth="500"
x:DataType="vm:ImportSessionsViewModel"
Background="{DynamicResource SufniSurfacePage}"
lifecycle:ViewLifecycle.AttachedToVisualTreeCommand="{Binding LoadedCommand}"
lifecycle:ViewLifecycle.DetachedFromVisualTreeCommand="{Binding UnloadedCommand}"
mc:Ignorable="d">

    <views:ImportSessionsContentView EnableMalformedMessageTap="True">
        <views:ImportSessionsContentView.BottomContent>
            <shared:ImportSessionsActionRow ShowBackButton="True" />
        </views:ImportSessionsContentView.BottomContent>
    </views:ImportSessionsContentView>
</UserControl>
