<UserControl
    x:Name="Root"
    x:Class="Sufni.App.LiveDaq.Views.Shared.LiveDaqDeviceManagementCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Sufni.App.LiveDaq.ViewModels.Editors"
    d:DesignHeight="250"
    d:DesignWidth="320"
    x:DataType="vm:LiveDaqDetailViewModel"
    mc:Ignorable="d">

    <Border
        Padding="{Binding #Root.CardPadding}"
        Background="{DynamicResource SufniBackgroundDisabled}"
        CornerRadius="8">
        <StackPanel Spacing="10">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="Device Management" />

            <Border Name="SetTimeButtonContainer" ToolTip.Tip="{Binding ManagementDisabledTooltip}">
                <Button
                    Name="SetTimeButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SetTimeCommand}"
                    Content="Set Time"
                    IsEnabled="{Binding CanManage}"
                    ToolTip.Tip="Sets the device clock to this computer's time." />
            </Border>

            <Border Name="EditConfigButtonContainer" ToolTip.Tip="{Binding ManagementDisabledTooltip}">
                <Button
                    Name="EditConfigButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding EditConfigCommand}"
                    Content="Edit CONFIG"
                    IsEnabled="{Binding CanManage}"
                    ToolTip.Tip="Downloads the device's CONFIG file to edit its fields here." />
            </Border>

            <Border Name="SelectConfigButtonContainer" ToolTip.Tip="{Binding ManagementDisabledTooltip}">
                <Button
                    Name="SelectConfigButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SelectConfigFileCommand}"
                    Content="Replace Config"
                    IsEnabled="{Binding CanManage}"
                    ToolTip.Tip="Picks a CONFIG file from disk and stages it for upload." />
            </Border>

            <TextBlock
                Name="PendingConfigTextBlock"
                IsVisible="{Binding HasPendingConfig}"
                Opacity="0.7"
                Text="{Binding PendingConfigFileName, StringFormat='Staged: {0}'}" />

            <Border Name="UploadConfigButtonContainer" ToolTip.Tip="{Binding ManagementDisabledTooltip}">
                <Button
                    Name="UploadConfigButton"
                    HorizontalAlignment="Stretch"
                    Command="{Binding UploadConfigCommand}"
                    Content="Upload CONFIG"
                    IsEnabled="{Binding CanUploadConfig}"
                    ToolTip.Tip="Sends the staged CONFIG file to the device, replacing the one on it." />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
