<UserControl
    x:Name="Root"
    x:Class="Sufni.App.LiveDaq.Views.Shared.LiveSessionHeaderFields"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Sufni.App.LiveDaq.ViewModels.Editors"
    d:DesignHeight="88"
    d:DesignWidth="320"
    x:DataType="vm:LiveSessionDetailViewModel"
    mc:Ignorable="d">

    <StackPanel>
        <StackPanel
            IsVisible="{Binding HasSessionHeader}"
            Spacing="{Binding #Root.FieldSpacing}">
            <TextBlock
                x:Name="LiveSessionIdTextBlock"
                FontSize="{Binding #Root.FieldFontSize}"
                Opacity="{Binding #Root.FieldOpacity}"
                Text="{Binding SessionIdText}" />
            <TextBlock
                x:Name="LiveAcceptedTravelRateTextBlock"
                FontSize="{Binding #Root.FieldFontSize}"
                Opacity="{Binding #Root.FieldOpacity}"
                Text="{Binding AcceptedTravelRateText}"
                ToolTip.Tip="The rates the board granted for this recording, which can be lower than requested." />
            <TextBlock
                x:Name="LiveAcceptedImuRateTextBlock"
                FontSize="{Binding #Root.FieldFontSize}"
                Opacity="{Binding #Root.FieldOpacity}"
                Text="{Binding AcceptedImuRateText}"
                ToolTip.Tip="The rates the board granted for this recording, which can be lower than requested." />
            <TextBlock
                x:Name="LiveAcceptedGpsRateTextBlock"
                FontSize="{Binding #Root.FieldFontSize}"
                Opacity="{Binding #Root.FieldOpacity}"
                Text="{Binding AcceptedGpsRateText}"
                ToolTip.Tip="The rates the board granted for this recording, which can be lower than requested." />
        </StackPanel>

        <TextBlock
            x:Name="LiveWaitingForHeaderTextBlock"
            FontSize="{Binding #Root.FieldFontSize}"
            IsVisible="{Binding !HasSessionHeader}"
            Opacity="{Binding #Root.WaitingOpacity}"
            Text="Waiting for the accepted live session header." />
    </StackPanel>
</UserControl>
