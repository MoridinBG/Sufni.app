<UserControl
x:Name="Root"
x:Class="Sufni.App.LiveDaq.Views.Controls.LiveSessionGraphRowsView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:overlays="clr-namespace:Sufni.App.Shared.Views.Overlays"
    xmlns:plots2="clr-namespace:Sufni.App.MapsAndTracks.Views.Plots"
xmlns:controls="clr-namespace:Sufni.App.Shared.Views.Controls"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:models="clr-namespace:Sufni.App.Infrastructure"
xmlns:plotModels="clr-namespace:Sufni.App.MapsAndTracks.Plots"
xmlns:plots="clr-namespace:Sufni.App.LiveDaq.Views.Plots"
xmlns:vm="clr-namespace:Sufni.App.Sessions.Detail.ViewModels.Editors"
d:DesignHeight="450"
d:DesignWidth="800"
x:DataType="vm:ILiveSessionGraphWorkspace"
mc:Ignorable="d">

    <controls:TelemetryPlotsRoot x:Name="GraphRoot" GraphPreferences="{Binding GraphPreferences, Mode=TwoWay}">
        <controls:TelemetryPlotsRoot.Rows>
            <controls:TelemetryPlotRow
            RowId="{x:Static models:TelemetryGraphRowIds.Travel}"
            Title="Travel (mm)"
            PresentationState="{Binding TravelGraphState}">
                <controls:TelemetryPlotRow.PlotContent>
                    <plots:LiveTravelPlotView
                    x:Name="TravelPlot"
                    GraphBatches="{Binding GraphBatches}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    MaximumY="{Binding PlotRanges.TravelMaximum}"
                    SourceVisibility="{Binding SourceVisibility}"
                    SmoothingLevel="{Binding PlotPreferences.TravelSmoothing}"
                    Timeline="{Binding Timeline}" />
                </controls:TelemetryPlotRow.PlotContent>
                <controls:TelemetryPlotRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="Travel" />
                </controls:TelemetryPlotRow.PlaceholderContent>
                <controls:TelemetryPlotRow.ChildRows>
                    <controls:TelemetryPlotRow
                    RowId="{x:Static models:TelemetryGraphRowIds.Velocity}"
                    Title="Velocity (m/s)"
                    PresentationState="{Binding VelocityGraphState}">
                        <controls:TelemetryPlotRow.PlotContent>
                            <plots:LiveVelocityPlotView
                            x:Name="VelocityPlot"
                            GraphBatches="{Binding GraphBatches}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            MinimumY="{Binding PlotRanges.VelocityMinimum}"
                            MaximumY="{Binding PlotRanges.VelocityMaximum}"
                            SourceVisibility="{Binding SourceVisibility}"
                            SmoothingLevel="{Binding PlotPreferences.VelocitySmoothing}"
                            Timeline="{Binding Timeline}" />
                        </controls:TelemetryPlotRow.PlotContent>
                        <controls:TelemetryPlotRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Velocity" />
                        </controls:TelemetryPlotRow.PlaceholderContent>
                    </controls:TelemetryPlotRow>
                </controls:TelemetryPlotRow.ChildRows>
            </controls:TelemetryPlotRow>

            <controls:TelemetryPlotRow
            RowId="{x:Static models:TelemetryGraphRowIds.Imu}"
            Title="Vibration RMS (g)"
            PresentationState="{Binding ImuGraphState}">
                <controls:TelemetryPlotRow.PlotContent>
                    <plots:LiveImuPlotView
                    x:Name="ImuPlot"
                    GraphBatches="{Binding GraphBatches}"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    MaximumY="{Binding PlotRanges.ImuMaximum}"
                    SourceVisibility="{Binding SourceVisibility}"
                    SmoothingLevel="{Binding PlotPreferences.ImuSmoothing}"
                    Timeline="{Binding Timeline}" />
                </controls:TelemetryPlotRow.PlotContent>
                <controls:TelemetryPlotRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="IMU" />
                </controls:TelemetryPlotRow.PlaceholderContent>
                <controls:TelemetryPlotRow.ChildRows>
                    <controls:TelemetryPlotRow
                    RowId="{x:Static models:TelemetryGraphRowIds.PitchRoll}"
                    Title="Frame pitch/roll (deg)"
                    PresentationState="{Binding PitchRollGraphState}">
                        <controls:TelemetryPlotRow.PlotContent>
                            <plots:LiveFramePitchRollPlotView
                            x:Name="PitchRollPlot"
                            GraphBatches="{Binding GraphBatches}"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            MaximumY="{Binding PlotRanges.PitchRollMaximum}"
                            MinimumY="{Binding PlotRanges.PitchRollMinimum}"
                            SmoothingLevel="{Binding PlotPreferences.PitchRollSmoothing}"
                            Timeline="{Binding Timeline}" />
                        </controls:TelemetryPlotRow.PlotContent>
                        <controls:TelemetryPlotRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Pitch/roll" />
                        </controls:TelemetryPlotRow.PlaceholderContent>
                    </controls:TelemetryPlotRow>
                </controls:TelemetryPlotRow.ChildRows>
            </controls:TelemetryPlotRow>

            <controls:TelemetryPlotRow
            RowId="{x:Static models:TelemetryGraphRowIds.Speed}"
            Title="GPS speed (km/h)"
            PresentationState="{Binding SpeedGraphState}">
                <controls:TelemetryPlotRow.PlotContent>
                    <plots2:TrackSignalPlotView
                    x:Name="SpeedPlot"
                    HideRightAxis="{Binding #Root.HideRightAxis}"
                    SignalKind="{x:Static plotModels:TrackSignalKind.Speed}"
                    SmoothingLevel="{Binding PlotPreferences.SpeedSmoothing}"
                    Timeline="{Binding Timeline}"
                    TimelineContext="{Binding TrackTimelineContext}"
                    TrackPoints="{Binding TrackPoints}" />
                </controls:TelemetryPlotRow.PlotContent>
                <controls:TelemetryPlotRow.PlaceholderContent>
                    <overlays:SurfacePlaceholderCard Title="Speed" />
                </controls:TelemetryPlotRow.PlaceholderContent>
                <controls:TelemetryPlotRow.ChildRows>
                    <controls:TelemetryPlotRow
                    RowId="{x:Static models:TelemetryGraphRowIds.Elevation}"
                    Title="Elevation (m)"
                    PresentationState="{Binding ElevationGraphState}">
                        <controls:TelemetryPlotRow.PlotContent>
                            <plots2:TrackSignalPlotView
                            x:Name="ElevationPlot"
                            HideRightAxis="{Binding #Root.HideRightAxis}"
                            SignalKind="{x:Static plotModels:TrackSignalKind.Elevation}"
                            SmoothingLevel="{Binding PlotPreferences.ElevationSmoothing}"
                            Timeline="{Binding Timeline}"
                            TimelineContext="{Binding TrackTimelineContext}"
                            TrackPoints="{Binding TrackPoints}" />
                        </controls:TelemetryPlotRow.PlotContent>
                        <controls:TelemetryPlotRow.PlaceholderContent>
                            <overlays:SurfacePlaceholderCard Title="Elevation" />
                        </controls:TelemetryPlotRow.PlaceholderContent>
                    </controls:TelemetryPlotRow>
                </controls:TelemetryPlotRow.ChildRows>
            </controls:TelemetryPlotRow>
        </controls:TelemetryPlotsRoot.Rows>
    </controls:TelemetryPlotsRoot>
</UserControl>
