<UserControl
x:Class="Sufni.App.LiveDaq.DesktopViews.Editors.LiveSessionDetailDesktopView"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="clr-namespace:Sufni.App.Sessions.Presentation.Views"
    xmlns:items2="clr-namespace:Sufni.App.Sessions.Detail.DesktopViews.Items"
    xmlns:items3="clr-namespace:Sufni.App.Sessions.Media.DesktopViews.Items"
    xmlns:items4="clr-namespace:Sufni.App.Sessions.Analysis.DesktopViews.Items"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:editors="clr-namespace:Sufni.App.Sessions.Detail.DesktopViews.Editors"
xmlns:items="clr-namespace:Sufni.App.LiveDaq.DesktopViews.Items"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:overlays="clr-namespace:Sufni.App.Shared.Views.Overlays"
xmlns:vm="clr-namespace:Sufni.App.LiveDaq.ViewModels.Editors"
xmlns:lifecycle="clr-namespace:Sufni.App.Shared.Views"
d:DesignHeight="800"
d:DesignWidth="800"
x:Name="Root"
x:DataType="vm:LiveSessionDetailViewModel"
Background="{DynamicResource SufniSurfacePage}"
Focusable="True"
lifecycle:ViewLifecycle.LoadedCommand="{Binding LoadedCommand}"
lifecycle:ViewLifecycle.UnloadedCommand="{Binding UnloadedCommand}"
mc:Ignorable="d">

    <Grid>
        <editors:SessionShellDesktopView
            HasMediaContent="{Binding MediaWorkspace.HasMediaContent}"
            IsVisible="{Binding ShellMobileWorkspace.ScreenState.IsReady}">

            <editors:SessionShellDesktopView.SignalsContent>
                <items:LiveSessionSignalsDesktopView DataContext="{Binding $parent[UserControl].((vm:LiveSessionDetailViewModel)DataContext).SignalsWorkspace}" />
            </editors:SessionShellDesktopView.SignalsContent>

            <editors:SessionShellDesktopView.MediaContent>
                <items3:SessionMediaDesktopView DataContext="{Binding $parent[UserControl].((vm:LiveSessionDetailViewModel)DataContext).MediaWorkspace}" />
            </editors:SessionShellDesktopView.MediaContent>

            <editors:SessionShellDesktopView.AnalysisContent>
                <items4:SessionAnalysisDesktopView DataContext="{Binding $parent[UserControl].((vm:LiveSessionDetailViewModel)DataContext).AnalysisWorkspace}" />
            </editors:SessionShellDesktopView.AnalysisContent>

            <editors:SessionShellDesktopView.ControlContent>
                <items:LiveSessionControlsDesktopView DataContext="{Binding $parent[UserControl].((vm:LiveSessionDetailViewModel)DataContext)}" />
            </editors:SessionShellDesktopView.ControlContent>

            <editors:SessionShellDesktopView.SidebarContent>
                <items2:SessionSidebarDesktopView DataContext="{Binding $parent[UserControl].((vm:LiveSessionDetailViewModel)DataContext).SidebarWorkspace}" />
            </editors:SessionShellDesktopView.SidebarContent>
        </editors:SessionShellDesktopView>

        <presentation:SessionScreenStateOverlay Name="ScreenOverlay" ScreenState="{Binding ShellMobileWorkspace.ScreenState}" />

    </Grid>

</UserControl>
