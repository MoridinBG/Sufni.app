<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sufni.App.Terrain.ViewModels"
             xmlns:views="using:Sufni.App.Terrain.Views"
             x:Class="Sufni.App.Terrain.Views.TerrainClassFilterView"
             x:Name="Root" x:DataType="vm:TerrainScopeViewModel" IsVisible="{Binding Available, FallbackValue=False}">
    <UserControl.Resources>
        <DataTemplate x:Key="Chip" x:DataType="vm:TerrainScopeOption">
            <ToggleButton IsChecked="{Binding IsChecked, Mode=OneWay}" Command="{Binding Select}" IsEnabled="{Binding IsEnabled}" Padding="4,1" Margin="1"
                          FontSize="{StaticResource SufniFontSizeSmall}" AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding DistanceMetres, StringFormat='{}{0:0.#} m'}" Opacity="0.75" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ChipRow"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    </UserControl.Resources>
    <Panel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !#Root.Compact}">
            <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource ChipRow}" />
        </StackPanel>
        <Button Name="FilterButton" Content="Filter" IsVisible="{Binding #Root.Compact}" Padding="8,1" VerticalAlignment="Center">
            <Button.Flyout>
                <Flyout Placement="Bottom">
                    <StackPanel Spacing="4">
                        <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource Chip}" ItemsPanel="{StaticResource ChipRow}" />
                        <TextBlock Text="Grade" Margin="0,4,0,0" />
                        <views:TerrainLegendView Options="{Binding Grade}" />
                        <TextBlock Text="Roughness" />
                        <views:TerrainLegendView Options="{Binding Roughness}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Panel>
</UserControl>
