<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Sufni.App.Terrain.Models"
             xmlns:views="using:Sufni.App.Terrain.Views"
             x:Class="Sufni.App.Terrain.Views.GroundComfortView" x:DataType="models:GroundComfortReport">
    <UserControl.Resources>
        <views:TerrainSwatchConverter x:Key="Swatch" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.step">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.explain">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="models:ComfortFigure">
            <TextBlock>
                <Run Text="{Binding Measured}" />
                <Run Text="{Binding Usual, StringFormat=' · {0}'}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.DataTemplates>
    <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
        <TextBlock Classes="step" Text="Ground" />
        <TextBlock Classes="explain" Text="Distance on each roughness level inside the scope." />
        <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:GroundComfortLevel">
                    <Grid Margin="0,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Level" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Distance" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{Binding Class, Converter={StaticResource Swatch}}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Share}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Distance}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="step" Text="Absorbed" />
        <TextBlock Classes="explain" Text="How much the fork and shock moved on each level, against your usual when it is ready." />
        <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:GroundComfortLevel">
                    <Grid Margin="0,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Level" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Fork" Opacity="0.75" />
                            <ContentControl Content="{Binding Fork}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Shock" Opacity="0.75" />
                            <ContentControl Content="{Binding Shock}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="note" Text="{Binding UsualNote}" IsVisible="{Binding HasUsualNote}" />

        <TextBlock Classes="step" Text="Reached the frame" />
        <TextBlock Classes="explain"
                   Text="Frame vibration on each level as you felt it, and how much of the ground's vibration passed to the frame against your usual." />
        <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:GroundComfortLevel">
                    <Grid Margin="0,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Level" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" />
                        <ContentControl Grid.Column="1" Content="{Binding Frame}" />
                        <TextBlock Grid.Column="2" IsVisible="{Binding HasPassedToFrame}">
                            <Run Text="Passed to the frame" Foreground="{DynamicResource SufniTextSecondary}" />
                            <Run Text="{Binding PassedToFrame}" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="note" Text="{Binding FrameNote}" IsVisible="{Binding HasFrameNote}" />
    </StackPanel>
</UserControl>
