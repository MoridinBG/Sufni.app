<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sufni.App.Terrain.ViewModels"
             x:Class="Sufni.App.Terrain.Views.TerrainClassFilterBannerView"
             x:DataType="vm:TerrainScopeViewModel" IsVisible="{Binding Available, FallbackValue=False}">
    <Border Padding="8,4" CornerRadius="4" Background="{DynamicResource SufniSelectionSurfaceSubtle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Default" Command="{Binding Reset}" IsVisible="{Binding !IsDefault}" AutomationProperties.Name="Use the default terrain scope" />
        </Grid>
    </Border>
</UserControl>
