<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sufni.App.Terrain.ViewModels"
             x:Class="Sufni.App.Terrain.Views.TerrainClassFilterBannerView"
             x:DataType="vm:TerrainClassFilterViewModel" IsVisible="{Binding IsActive, FallbackValue=False}">
    <Border Padding="8,4" CornerRadius="4" Background="{DynamicResource SufniSelectionSurfaceSubtle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Clear" Command="{Binding Clear}" AutomationProperties.Name="Clear terrain filter" />
        </Grid>
    </Border>
</UserControl>
