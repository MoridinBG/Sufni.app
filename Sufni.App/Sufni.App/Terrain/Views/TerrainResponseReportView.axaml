<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Sufni.App.Terrain.Models"
             xmlns:views="using:Sufni.App.Terrain.Views"
             x:Class="Sufni.App.Terrain.Views.TerrainResponseReportView" x:DataType="models:TerrainResponseReport">
    <UserControl.Resources>
        <DataTemplate x:Key="ResponseScale" x:DataType="models:TerrainResponseReport">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Measure" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <Panel Grid.Column="1">
                    <TextBlock Classes="scale" Text="{Binding ScaleStart}" HorizontalAlignment="Left" />
                    <TextBlock Classes="scale" Text="0" HorizontalAlignment="Center" />
                    <TextBlock Classes="scale" Text="{Binding ScaleEnd}" HorizontalAlignment="Right" />
                </Panel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="views|DeviationBar">
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TrackBrush" Value="{DynamicResource SufniSelectionSurfaceSubtleBrush}" />
            <Setter Property="BandBrush" Value="{DynamicResource SufniLineSubtleBrush}" />
            <Setter Property="BarBrush" Value="{DynamicResource SufniTextSecondary}" />
            <Setter Property="LineBrush" Value="{DynamicResource SufniLineDefaultBrush}" />
        </Style>
        <Style Selector="views|DeviationBar.finding">
            <Setter Property="BarBrush" Value="{DynamicResource SufniAccentPrimary}" />
        </Style>
        <Style Selector="Grid.lowConfidence">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SufniStatusWarningBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="{StaticResource SufniFontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource SufniStatusWarningBrush}" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="{StaticResource SufniFontSizeSmall}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource SufniTextSecondary}" />
        </Style>
        <Style Selector="TextBlock.scale">
            <Setter Property="FontSize" Value="{StaticResource SufniFontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource SufniTextSecondary}" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="models:ResponseVerdict">
            <WrapPanel>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Border Name="LowConfidence" Classes="badge" Margin="8,0,0,0" IsVisible="{Binding IsLowConfidence}"
                        ToolTip.Tip="{Binding ConfidenceNote}">
                    <TextBlock Text="Low confidence" />
                </Border>
            </WrapPanel>
        </DataTemplate>
        <DataTemplate DataType="models:ResponseBar">
            <Grid Margin="0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Measure" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="small" Text="{Binding Label}" ToolTip.Tip="{Binding Explanation}" VerticalAlignment="Center" />
                <views:DeviationBar Grid.Column="1" Classes.finding="{Binding IsFinding}" Deviation="{Binding Deviation}"
                                    RepeatRange="{Binding RepeatRange}"
                                    Scale="{Binding $parent[views:TerrainResponseReportView].((models:TerrainResponseReport)DataContext).Scale, FallbackValue=1}" />
                <TextBlock Grid.Column="2" Classes="small" Text="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <StackPanel Spacing="10">
        <TextBlock Name="Summary" Text="{Binding Summary}" IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" />
        <StackPanel Name="ForkVerdicts" Spacing="2" IsVisible="{Binding HasForkVerdicts}">
            <TextBlock Text="Fork" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Fork}" />
        </StackPanel>
        <StackPanel Name="ShockVerdicts" Spacing="2" IsVisible="{Binding HasShockVerdicts}">
            <TextBlock Text="Shock" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Shock}" />
        </StackPanel>
        <TextBlock Name="Guide" Classes="small secondary" Text="{Binding Guide}" TextWrapping="Wrap" IsVisible="{Binding HasChart}" />
        <Grid Name="ChartEnds" ColumnDefinitions="*,*" ColumnSpacing="24" IsVisible="{Binding HasChart}">
            <TextBlock Text="Fork" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Shock" FontWeight="SemiBold" />
        </Grid>
        <ItemsControl Name="Chart" ItemsSource="{Binding Chart}" IsVisible="{Binding HasChart}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ResponseChartRow">
                    <StackPanel Margin="0,6" Spacing="4">
                        <WrapPanel>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" ToolTip.Tip="{Binding CoverageNote}">
                                <Run Text="{Binding Label}" FontWeight="SemiBold" />
                                <Run Text="{Binding Coverage, Mode=OneWay, StringFormat=' · {0}'}" FontSize="{StaticResource SufniFontSizeSmall}"
                                     Foreground="{DynamicResource SufniTextSecondary}" />
                            </TextBlock>
                            <Border Name="LowConfidence" Classes="badge" Margin="8,0,0,0" IsVisible="{Binding IsLowConfidence}"
                                    ToolTip.Tip="{Binding ConfidenceNote}">
                                <TextBlock Text="Low confidence" />
                            </Border>
                        </WrapPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Classes.lowConfidence="{Binding IsLowConfidence}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Fork}" />
                                <ContentControl Content="{Binding $parent[views:TerrainResponseReportView].DataContext}" ContentTemplate="{StaticResource ResponseScale}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding Shock}" />
                                <ContentControl Content="{Binding $parent[views:TerrainResponseReportView].DataContext}" ContentTemplate="{StaticResource ResponseScale}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
