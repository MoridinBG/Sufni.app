<UserControl
    x:Class="Sufni.App.Segments.DesktopViews.SegmentPickerFlyoutButtonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Sufni.App.Segments.Views"
    xmlns:vm="clr-namespace:Sufni.App.Segments.ViewModels"
    d:DesignHeight="40"
    d:DesignWidth="96"
    x:DataType="vm:SegmentPickerViewModel"
    mc:Ignorable="d">

    <Button
        x:Name="SegmentsButton"
        MinWidth="72"
        Content="Segments"
        IsEnabled="{Binding CanOpen}"
        ToolTip.Tip="Open saved segments">
        <Button.Flyout>
            <Flyout
                Closed="SegmentsFlyout_OnClosed"
                Flyout.FlyoutPresenterClasses="wide"
                Opened="SegmentsFlyout_OnOpened"
                Placement="BottomEdgeAlignedRight">
                <views:SegmentPickerPanelView x:Name="PickerPanel" />
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
