<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sufni.App.Segments.ViewModels"
             xmlns:terrain="using:Sufni.App.Terrain.Views"
             x:DataType="vm:SegmentComparisonViewModel"
             x:Class="Sufni.App.Segments.Views.SegmentTerrainComparisonView"
             IsVisible="{Binding HasAnalysisComparison, FallbackValue=False}">
    <StackPanel Spacing="6" Margin="0,6,0,12">
        <TextBlock Text="Same-trail comparison" FontWeight="SemiBold" />
        <TextBlock Name="Message" Text="{Binding TerrainReport.Message}" IsVisible="{Binding TerrainReport.HasMessage, FallbackValue=False}"
                   TextWrapping="Wrap" />
        <TextBlock Name="Pace" Text="{Binding TerrainReport.Pace}" IsVisible="{Binding TerrainReport.HasPace, FallbackValue=False}"
                   TextWrapping="Wrap" />
        <Panel IsVisible="{Binding TerrainReport.HasResponse, FallbackValue=False}">
            <terrain:TerrainResponseReportView Name="Report" DataContext="{Binding TerrainReport.Response}" />
        </Panel>
    </StackPanel>
</UserControl>
