<Project>
  <PropertyGroup>
    <SufniPrivateExtensionsRoot Condition="'$(SufniPrivateExtensionsRoot)' == ''">$(MSBuildThisFileDirectory)../Sufni.PrivateExtensions/</SufniPrivateExtensionsRoot>
    <SufniPrivateExtensionsProps>$(SufniPrivateExtensionsRoot)Directory.Private.props</SufniPrivateExtensionsProps>
    <SufniPrivateExtensionsTargets>$(SufniPrivateExtensionsRoot)Directory.Private.targets</SufniPrivateExtensionsTargets>
  </PropertyGroup>

  <Target Name="FailWhenPrivateExtensionsRequestedButMissing"
          BeforeTargets="PrepareForBuild"
          Condition="'$(SufniEnablePrivateExtensions)' == 'true' and (!Exists('$(SufniPrivateExtensionsProps)') or !Exists('$(SufniPrivateExtensionsTargets)'))">
    <Error Text="SufniEnablePrivateExtensions=true requires Directory.Private.props and Directory.Private.targets under SufniPrivateExtensionsRoot." />
  </Target>

  <Import Project="$(SufniPrivateExtensionsTargets)" Condition="Exists('$(SufniPrivateExtensionsTargets)')" />
</Project>
