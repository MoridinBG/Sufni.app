<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>17.5</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <ApplicationId>com.sghctoma.sufni.devicetests</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <ProjectReference Include="../../Sufni.App/Sufni.App/Sufni.App.csproj" />
    <Compile Include="../../Sufni.Telemetry.Tests/GoldenTelemetryCompatibilityFixtures.cs" Link="GoldenTelemetryCompatibilityFixtures.cs" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
