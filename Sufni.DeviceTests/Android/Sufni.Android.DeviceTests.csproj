<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <ApplicationId>com.sghctoma.sufni.devicetests</ApplicationId>
    <AndroidManifest>../../Sufni.App/Sufni.App.Android/Properties/AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <ProjectReference Include="../../Sufni.App/Sufni.App/Sufni.App.csproj" />
    <Compile Include="../../Sufni.App/Sufni.App.Android/AndroidServiceDiscovery.cs" Link="AndroidServiceDiscovery.cs" />
    <Compile Include="../../Sufni.App/Sufni.App.Android/AndroidMulticastLockFactory.cs" Link="AndroidMulticastLockFactory.cs" />
    <Compile Include="../../Sufni.App/Sufni.App.Android/AndroidLocalNetworkPermission.cs" Link="AndroidLocalNetworkPermission.cs" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
